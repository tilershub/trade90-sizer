---
import yieldData from "../data/trade90-yield-curves.json";
const {pair}=Astro.props;
const base=yieldData.currencies?.[pair.base],quote=yieldData.currencies?.[pair.quote];
const verified=x=>x?.verified===true&&Number.isFinite(x?.yields?.['2Y'])&&Number.isFinite(x?.yields?.['10Y']);
const days=verified(base)&&verified(quote)?Math.abs(Date.parse(base.asOf)-Date.parse(quote.asOf))/86400000:null;
const comparable=verified(base)&&verified(quote)&&days<=3;
const fmt=n=>Number.isFinite(n)?(n>0?"+":"")+Math.round(n)+" bp":"—";
const diff=tenor=>comparable?(base.yields[tenor]-quote.yields[tenor])*100:null;
const target="/yield-curves/?currency="+pair.base+"&quote="+pair.quote;
---
<section class="yield-mini" id="yield-curve" aria-labelledby="yield-mini-title">
 <div class="heading">
  <div><div class="eyebrow">OPTIONAL BOND MARKET CONTEXT</div><h2 id="yield-mini-title">{pair.label} · Government yield spreads</h2></div>
  <a class="yield-link" href={target}>Full Yield Curve Intelligence →</a>
 </div>
 {comparable ? <>
  <div class="metrics"><div><span>2Y sovereign spread</span><strong>{fmt(diff("2Y"))}</strong></div><div><span>10Y sovereign spread</span><strong>{fmt(diff("10Y"))}</strong></div></div>
  <p>{pair.base} observed {base.asOf}; {pair.quote} observed {quote.asOf}. Government-bond instruments differ between countries; these spreads do not estimate central-bank policy-rate moves.</p>
 </> : <p class="pending">Comparable government-yield spreads are currently unavailable for this pair. Both currencies require verified 2Y/10Y values observed within three days. <a href={target}>Review country yield curves and data status →</a></p>}
</section>
<style>
.yield-mini{padding:17px 19px;border:1px solid var(--line);background:var(--surface);border-radius:12px;scroll-margin-top:90px}.heading{display:flex;justify-content:space-between;align-items:center;gap:12px}.heading h2{font-size:1.04rem;color:var(--ink);margin:3px 0 9px}.eyebrow{font-size:.63rem;letter-spacing:.09em;font-weight:800;color:var(--blue)}.yield-link,.pending a{color:var(--blue);font-size:.79rem;font-weight:750}.yield-mini p{font-size:.76rem;color:var(--muted);margin:10px 0 0;line-height:1.65}.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.metrics>div{border:1px solid var(--line);border-radius:9px;background:var(--soft);padding:12px}.metrics span{display:block;color:var(--muted);font-size:.73rem}.metrics strong{display:block;color:var(--ink);font-size:1.24rem;margin-top:5px}.pending{max-width:780px}@media(max-width:600px){.yield-mini{padding:12px}.heading{display:block}.yield-link{display:inline-block;margin:2px 0 10px}.metrics>div{padding:10px}}
</style>