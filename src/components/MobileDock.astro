---
const path = Astro.url.pathname;
const items = [
  { href:'/', label:'Home', icon:'home', active:path==='/' },
  { href:'/research/', label:'Research', icon:'search', active:path.startsWith('/research') || path==='/tools/fx-research-terminal/' },
  { href:'/economic-calendar/', label:'Calendar', icon:'calendar', active:path.startsWith('/economic-calendar') },
  { href:'/today/', label:'Today', icon:'today', active:path.startsWith('/today') },
  { href:'/account/', label:'Account', icon:'account', active:path.startsWith('/account') || path.startsWith('/login') || path.startsWith('/join') },
];
const iconPath = {
  home:'M3 11.5 12 4l9 7.5v8a1.5 1.5 0 0 1-1.5 1.5H15v-6H9v6H4.5A1.5 1.5 0 0 1 3 19.5z',
  search:'M11 4a7 7 0 1 0 4.9 12l4.6 4.5 1.5-1.5-4.5-4.6A7 7 0 0 0 11 4zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10z',
  calendar:'M6 2h2v2h8V2h2v2h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2zm14 8H4v10h16z',
  today:'M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 5v4.6l3.2 1.9-1 1.7L11 12.8V7z',
  account:'M12 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 12c5.5 0 9 2.8 9 6v2H3v-2c0-3.2 3.5-6 9-6z',
};
---
<nav class="mobile-dock" aria-label="Primary mobile navigation">
  {items.map(item => (
    <a href={item.href} class:list={{active:item.active}} aria-current={item.active?'page':undefined}>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d={iconPath[item.icon]} /></svg>
      <strong>{item.label}</strong>
    </a>
  ))}
</nav>
<style>
.mobile-dock{display:none}
@media(max-width:767px){
  .mobile-dock{
    position:fixed;left:8px;right:8px;bottom:max(8px,env(safe-area-inset-bottom));
    z-index:40;display:grid;grid-template-columns:repeat(5,1fr);gap:2px;
    padding:6px;border:1px solid rgba(71,85,105,.78);border-radius:16px;
    background:rgba(2,6,23,.94);backdrop-filter:blur(18px);box-shadow:0 16px 40px rgba(2,6,23,.3)
  }
  .mobile-dock a{display:grid;place-items:center;gap:3px;min-height:48px;border-radius:11px;color:#94a3b8;text-decoration:none}
  .mobile-dock a.active{background:#064e3b;color:#ecfdf5}
  .mobile-dock svg{width:18px;height:18px;fill:currentColor}
  .mobile-dock strong{font-size:.56rem;letter-spacing:.02em}
}
</style>
