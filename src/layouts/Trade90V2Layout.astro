<style>
#trade90-cookie-banner[hidden]{display:none}
#trade90-cookie-banner{position:fixed;bottom:16px;left:16px;right:16px;z-index:1000;max-width:640px;margin:auto;padding:18px;background:#0f172a;color:#f8fafc;border:1px solid #64748b;border-radius:12px;box-shadow:0 8px 32px #0005;font-size:14px}
#trade90-cookie-banner p{margin:0 0 12px;color:#f8fafc}
