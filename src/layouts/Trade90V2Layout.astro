---
import "../styles/trade90-reading.css";
const {title="Central Bank Rate Divergence",description="Compare official central bank policy rates across 28 forex pairs. Explore current rate gaps, forward-rate data availability, policy changes, and pair details.",canonical="/",noindex=false} = Astro.props;
const url = new URL(canonical,"https://tradeninety.com").toString();
const structuredPage={"@context":"https://schema.org","@graph":[
 {"@type":"Organization","@id":"https://tradeninety.com/#publisher","name":"TRADE90","url":"https://tradeninety.com/"},
 {"@type":"WebPage","@id":url+"#page","url":url,"name":title,"description":description,"inLanguage":"en","publisher":{"@id":"https://tradeninety.com/#publisher"},"isPartOf":{"@id":"https://tradeninety.com/#website"}}
]};

---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#0f172a" />
  <script is:inline>(function(){try{var p=localStorage.getItem("trade90-appearance")||"system";var m=window.matchMedia("(prefers-color-scheme: light)").matches;document.documentElement.dataset.theme=p==="system"?(m?"light":"dark"):p;document.documentElement.dataset.appearance=p;}catch(e){document.documentElement.dataset.theme="dark";}})();</script>
  <script type="application/ld+json" set:html={JSON.stringify(structuredPage)}/>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="application-name" content="TRADE90" />
  <meta name="apple-mobile-web-app-title" content="TRADE90" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="TRADE90" />
  <meta property="og:title" content={title + " | TRADE90"} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content="https://tradeninety.com/og-v3.svg" />
  <meta property="og:image:type" content="image/svg+xml" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:image" content="https://tradeninety.com/og-v3.svg" />
  {canonical === "/" && <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite","@id":"https://tradeninety.com/#website","name":"TRADE90","url":"https://tradeninety.com/","inLanguage":"en","description":"Source-linked central bank rate divergence research for 28 forex currency pairs."})}/>}

  <meta name="twitter:card" content="summary_large_image" />
  <title>{title} | TRADE90</title>
  <!-- Existing TRADE90 GA4 property; one loader for every public page. -->
  <script is:inline>
    (function () {
      if (window.__trade90Analytics) return;
      const id = 'G-EBLQLRSZZL';
      let loaded = false;
      let choice = null;
      try { choice = localStorage.getItem('cookieConsent'); } catch (_) {}
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied', ad_storage: 'denied',
        ad_user_data: 'denied', ad_personalization: 'denied'
      });
      function apply(value) {
        choice = value;
        window.gtag('consent', 'update', { analytics_storage: value === 'accepted' ? 'granted' : 'denied' });
        if (value !== 'accepted' || loaded) return;
        loaded = true;
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
        document.head.appendChild(script);
        window.gtag('js', new Date());
        window.gtag('config', id, { allow_google_signals: false, allow_ad_personalization_signals: false });
      }
      window.__trade90Analytics = {
        getChoice: function () { return choice; },
        setChoice: function (value) {
          if (value !== 'accepted' && value !== 'declined') return;
          try { localStorage.setItem('cookieConsent', value); } catch (_) {}
          apply(value);
        }
      };
      if (choice === 'accepted') apply(choice);
    })();
  </script>
</head>
<body>
  <header class="topbar">
    <div class="wrap nav">
      <a href="/" class="brand" aria-label="TRADE90 homepage">TRADE<span>90</span></a>
      <nav class="desktop-links" aria-label="Main navigation">
        <a href="/daily/">Daily dashboard</a><a href="/pairs/">Explore pairs</a>
        <a href="/rate-gaps/">Rate gaps</a>
        <a href="/central-banks/">Central banks</a>
        <a href="/decisions/">Decisions</a>
        <a href="/learn/">Learn</a>
        <a href="/tools/position-size-calculator/">Trading tools</a>
      </nav>
      <div class="nav-actions">
        <label class="theme-label" for="trade90-theme"><span class="sr-only">Website appearance</span><select id="trade90-theme" aria-label="Appearance"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></label>
        <details class="mobile-menu"><summary>Menu</summary><nav aria-label="Mobile navigation">
          <a href="/daily/">Daily dashboard</a><a href="/pairs/">Explore pairs</a><a href="/rate-gaps/">Rate gaps</a><a href="/central-banks/">Central banks</a><a href="/decisions/">Decisions</a><a href="/learn/">Learn</a><a href="/tools/position-size-calculator/">Trading tools</a><a href="/methodology/">Methodology</a>
        </nav></details>
      </div>
    </div>
  </header>
  <slot />
  <footer class="footer">
    <div class="wrap footcontent">
      <div><a href="/" class="brand footerbrand">TRADE<span>90</span></a><p>Clear rate comparisons. Sourced information. No trading signals.</p></div>
      <div class="footlinks"><a href="/pairs/">Currency pairs</a><a href="/rate-gaps/">Rate gaps</a><a href="/decisions/">Next decisions</a><a href="/central-banks/">Central banks</a><a href="/learn/">Learn</a><a href="/tools/">Trading tools</a><a href="/tools/position-size-calculator/">Position size calculator</a><a href="/methodology/">Methodology</a><a href="/data-policy/">Data sources &amp; updates</a><a href="/about/">About</a><a href="/editorial-policy/">Editorial policy</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/disclaimer/">Risk disclaimer</a><button id="trade90-analytics-settings" type="button">Analytics preferences</button></div>
    </div>
    <div class="wrap fine">Educational and informational use only. A policy-rate gap is not a broker swap rate, a forward FX quote, or a prediction of currency performance.</div>
  </footer>
  <script is:inline>(function(){/* TRADE90 no longer uses an offline service worker; retire any old cache-first worker so it cannot pin the V2 homepage. */if(!("serviceWorker" in navigator))return;navigator.serviceWorker.getRegistrations().then(function(regs){regs.forEach(function(reg){if(reg.scope.indexOf(location.origin)===0)reg.unregister().catch(function(){});});}).catch(function(){});})();</script>
  <script is:inline>(function(){var s=document.getElementById("trade90-theme");if(!s)return;var p=document.documentElement.dataset.appearance||"system";s.value=p;function apply(v){var isLight=window.matchMedia("(prefers-color-scheme: light)").matches;document.documentElement.dataset.theme=v==="system"?(isLight?"light":"dark"):v;document.documentElement.dataset.appearance=v;}s.addEventListener("change",function(){try{localStorage.setItem("trade90-appearance",s.value)}catch(e){}apply(s.value);});try{window.matchMedia("(prefers-color-scheme: light)").addEventListener("change",function(){if(s.value==="system")apply("system")});}catch(e){} })();</script>
  <aside id="trade90-cookie-banner" aria-label="Analytics preferences" hidden>
    <p>Allow analytics cookies to help us understand how TRADE90 is used? <a href="/privacy/">Privacy policy</a></p>
    <div><button type="button" data-analytics-choice="accepted">Accept analytics</button><button type="button" data-analytics-choice="declined">Decline</button></div>
  </aside>
  <script is:inline>
    (function () {
      const banner = document.getElementById('trade90-cookie-banner');
      const analytics = window.__trade90Analytics;
      if (!banner || !analytics) return;
      banner.hidden = ['accepted', 'declined'].includes(analytics.getChoice());
      banner.querySelectorAll('[data-analytics-choice]').forEach(function (button) {
        button.addEventListener('click', function () {
          analytics.setChoice(button.getAttribute('data-analytics-choice'));
          banner.hidden = true;
        });
      });
      document.getElementById('trade90-analytics-settings').addEventListener('click', function () {
        banner.hidden = false;
        banner.querySelector('button').focus();
      });
    })();
  </script>
</body>
</html>
<style is:global>
:root {
  color-scheme:dark;
  --ink:#f8fafc;
  --muted:#94a3b8;
  --line:#334155;
  --surface:#0f172a;
  --soft:#172033;
  --navy:#020617;
  --blue:#34d399;
  --accent:#10b981;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;background:#020617}
body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0f172a;color:var(--ink);line-height:1.55}
a{color:#6ee7b7}
a:hover{color:#a7f3d0}
button,select,input{font:inherit}
button,a,select,input{outline-offset:3px}
:focus-visible{outline:3px solid #10b981}
.wrap{width:min(1200px,calc(100% - 36px));margin-inline:auto}
.topbar{background:rgba(0,0,0,.93);color:#fff;border-bottom:1px solid #1e293b;position:sticky;top:0;z-index:30;backdrop-filter:blur(12px)}
.nav{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.nav nav{display:flex;gap:25px;flex-wrap:wrap}
.nav nav a{color:#cbd5e1;text-decoration:none;text-transform:uppercase;letter-spacing:.1em;font-weight:800;font-size:.69rem}
.nav nav a:hover{color:#6ee7b7}
.brand{display:inline-flex;align-items:center;gap:0;color:#fff;text-decoration:none;font-size:1.18rem;font-weight:950;letter-spacing:-.055em;line-height:1}
.brand span{color:#10b981}
.brand:hover{color:#fff}
.footer{background:#000;color:#cbd5e1;margin-top:64px;padding:36px 0 26px;border-top:1px solid #1e293b}
.footcontent{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}
.footer p,.fine{color:#94a3b8;font-size:.81rem}
.footer p{margin:.6rem 0}
.footlinks{display:flex;gap:20px;align-items:start;flex-wrap:wrap;max-width:650px}
.footer .footlinks a{color:#cbd5e1;font-size:.79rem}
.footer .footlinks a:hover{color:#6ee7b7}
.fine{padding-top:20px;border-top:1px solid #1e293b;margin-top:20px}
.page-intro{padding:42px 0 18px}
.page-intro .eyebrow{font-weight:800;letter-spacing:.12em;text-transform:uppercase;font-size:.69rem;color:#34d399}
.page-intro h1{margin:7px 0 12px;max-width:920px;line-height:1.12;font-size:clamp(2rem,4.4vw,3.2rem);letter-spacing:-.045em;color:#f8fafc}
.page-intro p{color:#94a3b8;max-width:720px}
.section-heading{font-size:1.4rem;letter-spacing:-.025em;margin:0 0 12px;color:#f8fafc}
.card{background:#111c30;border:1px solid #334155;border-radius:16px;padding:22px;color:#f8fafc}
.article{max-width:790px;margin:0 auto}
.article p,.article li{color:#cbd5e1}
.article h2{margin-top:30px;color:#f8fafc}
.linkcard{display:block;border:1px solid #334155;border-radius:14px;padding:20px;background:#111c30;text-decoration:none;color:#f8fafc}
.linkcard:hover{border-color:#10b981;color:#f8fafc}
.linkcard p{color:#94a3b8;font-size:.9rem}
@media(max-width:600px){
  .wrap{width:calc(100% - 24px)}
  .nav{min-height:64px}
  .nav nav{gap:12px}
  .nav nav a{font-size:.62rem;letter-spacing:.045em}
  .brand{font-size:1.05rem}
  .page-intro{padding-top:30px}
  .card{padding:17px}
}

.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.nav-actions{display:flex;align-items:center;gap:10px}
.theme-label select{background:#0f172a;color:#e2e8f0;border:1px solid #475569;border-radius:8px;padding:7px 8px;font-size:.78rem;min-width:82px}
.mobile-menu{display:none;position:relative}
.mobile-menu summary{cursor:pointer;border:1px solid #475569;border-radius:8px;padding:8px 12px;font-size:.82rem;color:#e2e8f0;font-weight:760;list-style:none}
.mobile-menu summary::-webkit-details-marker{display:none}
.mobile-menu nav{position:absolute;right:0;top:calc(100% + 12px);width:220px;display:flex;flex-direction:column;gap:0;background:#0f172a;border:1px solid #475569;box-shadow:0 15px 35px #0008;border-radius:10px;overflow:hidden}
.mobile-menu nav a{display:block;padding:12px 16px;color:#e2e8f0;text-decoration:none;font-size:.83rem;border-bottom:1px solid #334155}
.mobile-menu nav a:hover{background:#1e293b}
@media(max-width:920px){.desktop-links{display:none!important}.mobile-menu{display:block}.nav{gap:12px}.topbar .brand{flex:none}}
@media(max-width:430px){.theme-label select{min-width:73px;padding:7px 4px;font-size:.71rem}}

/* V3 readable light mode with native dark-mode fallback. Preserve original branding. */
