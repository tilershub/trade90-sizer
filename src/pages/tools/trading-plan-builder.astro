---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {FIELDS,MARKETS} from '../../lib/research-plan.js';
---
<BaseLayout title="Research & Decision Plan Builder" description="Record market evidence, uncertainty, alternative scenarios and your decision to wait, research further or consider a trade.">
<main class="plan-page">
 <header><a href="/#terminal">← Research terminal</a><p class="eyebrow">TRADE90 · Research to decision</p><h1>Build your research plan.</h1><p>Start with evidence. Test your interpretation. Decide whether to wait, research further or consider a trade.</p></header>
 <p class="notice">Your decisions remain your own. Writing a complete plan does not establish confidence, accuracy or a probability of success.</p>
 <div class="controls"><label for="plan-market">Research market<select id="plan-market">{MARKETS.map(m=><option value={m}>{m}</option>)}</select></label><label for="plan-decision">Your current decision<select id="plan-decision"><option value="undecided">Undecided</option><option value="wait">Wait / no trade</option><option value="research">Research further</option><option value="consider">Consider a trade</option></select></label></div>
 <p id="market-handoff" role="status"></p>
 <div class="save-line"><span id="plan-progress">0 research sections recorded</span><span id="plan-save" role="status">Stored only in this browser</span></div>
 <section class="evidence"><h2>Capture the evidence</h2><p>Import the latest available macro snapshot for the selected market. This may be newer than the snapshot you viewed in the terminal. Existing captured evidence stays dated; it does not update automatically.</p><button type="button" id="import-evidence">Import latest macro evidence</button><p id="import-status" role="status"></p><label for="plan-evidence">Sources, observation dates and notes</label><textarea id="plan-evidence" rows="5" placeholder="Add source URLs, observation dates and confirmed facts. Identify reported or unverified information separately."></textarea></section>
 <div class="sections">{FIELDS.map(([id,title,hint],i)=><details open={i===0} data-execution={['sessions','setups','risk','management'].includes(id)?'true':undefined}><summary>{title}<span data-written={id}></span></summary><label for={`plan-${id}`}>{hint}</label><textarea id={`plan-${id}`} data-plan-field={id} rows="4"></textarea></details>)}</div>
 <p id="execution-note">Execution fields are optional. Waiting and further research are valid outcomes.</p>
 <div class="actions"><button type="button" id="plan-export">Download plan</button><button type="button" id="plan-print">Print / save PDF</button><button type="button" id="plan-clear">Clear this plan</button></div>
 <p class="storage-note">One working plan per browser. Switching markets keeps your notes; export before starting a different plan. Existing saved plans are preserved during migration. Download a copy for another device.</p>
 <nav><a href="/tools/position-size-calculator/">Position size calculator →</a><a href="/journal/">Review in your journal →</a><a href="/research-guide/">Research guide →</a></nav>
 <pre id="print-plan"></pre>
</main>
<script>
import {PLAN_KEY,LEGACY_KEY,FIELDS,MARKETS,normalizePlan,migrateLegacy,evidenceText,planMarkdown} from '../../lib/research-plan.js';
const byId=(id:string)=>document.getElementById(id)!;
const market=byId('plan-market') as HTMLSelectElement;
const decision=byId('plan-decision') as HTMLSelectElement;
const evidence=byId('plan-evidence') as HTMLTextAreaElement;
let plan=normalizePlan(null), storageError='', migrated=false;
try {const stored=localStorage.getItem(PLAN_KEY); if(stored){plan=normalizePlan(JSON.parse(stored));}else {const legacy=localStorage.getItem(LEGACY_KEY);if(legacy){plan=migrateLegacy(JSON.parse(legacy));migrated=true;}}}catch{storageError='Saved data could not be read. Download a copy of your work.';}
const requested=new URLSearchParams(location.search).get('market');
const hasNotes=Object.values(plan.fields).some(Boolean)||Boolean(plan.evidence);
if(requested&&MARKETS.includes(requested)){if(!hasNotes)plan.market=requested;else if(requested!==plan.market)byId('market-handoff').textContent=`You opened ${requested} from the terminal. Your saved ${plan.market} plan is retained. Export it before changing markets.`;}
market.value=plan.market;decision.value=plan.decision;evidence.value=plan.evidence;
for(const [id] of FIELDS)(byId('plan-'+id) as HTMLTextAreaElement).value=plan.fields[id];
function read(){plan.market=market.value;plan.decision=decision.value;plan.evidence=evidence.value;for(const [id]of FIELDS)plan.fields[id]=(byId('plan-'+id) as HTMLTextAreaElement).value;return plan;}
function render(){let count=0;for(const [id]of FIELDS){const written=Boolean(plan.fields[id].trim());document.querySelector(`[data-written="${id}"]`)!.textContent=written?'Recorded':'';if(!['sessions','setups','risk','management'].includes(id)&&written)count++;}byId('plan-progress').textContent=`${count}/9 research sections recorded · completeness only`;byId('execution-note').textContent=plan.decision==='consider'?'Before acting, define your execution conditions, risk limits and exit rules. No trade is required.':'Execution fields are optional. Waiting and further research are valid outcomes.';}
function save(){read();plan.updatedAt=new Date().toISOString();try{localStorage.setItem(PLAN_KEY,JSON.stringify(plan));byId('plan-save').textContent='Saved in this browser';}catch{byId('plan-save').textContent='Could not save in this browser. Download your plan.';}render();}
render();if(storageError)byId('plan-save').textContent=storageError;else if(migrated){save();byId('plan-save').textContent='Previous plan copied; original retained';}
document.querySelectorAll('textarea, #plan-market, #plan-decision').forEach(el=>el.addEventListener('input',save));
market.addEventListener('change',()=>{byId('market-handoff').textContent='Market changed. Existing notes and captured evidence remain unchanged; check that they match this market.';save();});
byId('import-evidence').addEventListener('click',async()=>{const button=byId('import-evidence') as HTMLButtonElement;const selected=market.value;button.disabled=true;byId('import-status').textContent='Loading source observations…';try{const response=await fetch('/api/research-context',{cache:'no-store',signal:AbortSignal.timeout(15000)});if(!response.ok)throw Error('Macro research is unavailable. Your existing evidence is unchanged.');const captured=evidenceText(await response.json(),selected);if(market.value!==selected)throw Error('Market changed during import. Try again for the selected market.');evidence.value=[evidence.value.trim(),captured].filter(Boolean).join('\n\n---\n\n');save();byId('import-status').textContent='Dated macro evidence appended. Review source dates and add the remaining research.';}catch(e){byId('import-status').textContent=e instanceof Error?e.message:'Evidence import failed. Existing notes are unchanged.';}finally{button.disabled=false;}});
byId('plan-export').addEventListener('click',()=>{save();const url=URL.createObjectURL(new Blob([planMarkdown(read())],{type:'text/markdown'}));const a=document.createElement('a');a.href=url;a.download='trade90-research-plan.md';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
function preparePrint(){byId('print-plan').textContent=planMarkdown(read());}
window.addEventListener('beforeprint',preparePrint);
byId('plan-print').addEventListener('click',()=>{preparePrint();window.print();});
byId('plan-clear').addEventListener('click',()=>{if(!confirm('Clear this working plan? Download a copy first.'))return;plan=normalizePlan(null);market.value=plan.market;decision.value=plan.decision;evidence.value='';for(const[id]of FIELDS)(byId('plan-'+id)as HTMLTextAreaElement).value='';byId('market-handoff').textContent='';byId('import-status').textContent='';save();});
</script>
<style>
.plan-page{max-width:850px;margin:auto;padding:28px 18px 48px;color:#e2e8f0}.plan-page header{margin-bottom:20px}h1{font-size:clamp(1.8rem,5vw,2.6rem);line-height:1.15;color:white;margin:10px 0}h2{font-size:1.15rem;font-weight:700}p{font-size:.95rem;line-height:1.6;margin:10px 0}.eyebrow{font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#6ee7b7;margin-top:20px}a{color:#6ee7b7;text-decoration:underline;text-underline-offset:4px}.notice{border-left:3px solid #64748b;padding:10px 14px;background:#172033;color:#cbd5e1}.controls{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:20px 0}label{display:block;font-size:.9rem;line-height:1.6;color:#cbd5e1}select,textarea{display:block;width:100%;background:#0b1220;color:#f8fafc;border:1px solid #64748b;border-radius:8px;padding:12px;margin-top:8px;font:inherit;font-size:16px}textarea{resize:vertical;min-height:110px}button{background:#064e3b;color:#ecfdf5;border:1px solid #34d399;border-radius:8px;padding:12px 16px;min-height:44px;font-weight:650;cursor:pointer}button:disabled{opacity:.6;cursor:wait}button:focus-visible,a:focus-visible,summary:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #6ee7b7;outline-offset:3px}.evidence,details{background:#111c2f;border:1px solid #334155;border-radius:12px;padding:16px;margin:12px 0}.evidence p{color:#cbd5e1}.evidence label{margin-top:12px}summary{cursor:pointer;min-height:44px;align-content:center;font-weight:700;color:#f8fafc}summary span{float:right;color:#6ee7b7;font-size:.72rem;font-weight:400}details[open] label{margin-top:12px}.save-line{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;font-size:.8rem;color:#cbd5e1}.actions,nav{display:flex;flex-wrap:wrap;gap:12px;margin:22px 0}.storage-note{font-size:.83rem;color:#cbd5e1}#print-plan{display:none}@media(max-width:520px){.controls{grid-template-columns:1fr}.plan-page{padding:20px 12px}.actions button{flex:1 1 auto}}@media print{.plan-page>:not(#print-plan){display:none!important}#print-plan{display:block;white-space:pre-wrap;overflow-wrap:anywhere;color:black;background:white;font:11pt/1.5 sans-serif}.plan-page{max-width:none;padding:0}}
</style>
