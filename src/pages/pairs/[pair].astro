---
import {displayRate,displayBenchmark,midpointNote} from "../../lib/trade90-rate-display.js";
import RefreshStatus from "../../components/Trade90RefreshStatus.svelte";
import FtmoAffiliate from "../../components/Trade90FtmoAffiliate.astro";
import Layout from "../../layouts/Trade90V2Layout.astro";
import PolicyOutlook from "../../components/Trade90PolicyOutlook.svelte";
import DivergenceHero from "../../components/Trade90DivergenceHero.astro";
import policyModel from "../../../public/data/policy-outlook.json";
import MacroComparison from "../../components/Trade90MacroComparison.svelte";
import YieldCurve from "../../components/Trade90YieldCurve.astro";
import macroData from "../../../public/data/macro-history.json";
import NextDecisions from "../../components/Trade90NextDecisions.svelte";
import PolicyUpdates from "../../components/Trade90PolicyUpdates.svelte";
import OfficialPublications from "../../components/Trade90OfficialPublications.svelte";
import PairGuidance from "../../components/Trade90PairGuidance.svelte";
import {allTrade90Pairs,pairSlug,pairUrl,pairInsight,formatPercent,reportDate,rateSnapshot} from "../../lib/trade90-v3.js";
import {formatBp} from "../../lib/trade90-rates.js";
import {researchForPair,researchUrl} from "../../lib/trade90-research.js";
import {getPairPolicyUpdates} from "../../data/trade90-policy-updates.js";
export function getStaticPaths(){
 return allTrade90Pairs.map(pair=>({params:{pair:pairSlug(pair.symbol)},props:{pair}}));
}
const {pair}=Astro.props;
const explanation=pairInsight(pair);
const previous=getPairPolicyUpdates(pair).slice(0,3);
const publishedResearch=researchForPair(pair.symbol);
const title=pair.label+" Interest Rate Differential & Policy Outlook";
const description="Compare the "+pair.label+" interest rate differential, "+pair.baseBank.short+" and "+pair.quoteBank.short+" policy rates, source dates and economic evidence. Explore the conditional 90-day outlook.";
const permalink=pairUrl(pair.symbol);
const relevant=allTrade90Pairs.filter(p=>p.symbol!==pair.symbol && (p.base===pair.base||p.quote===pair.base||p.base===pair.quote||p.quote===pair.quote)).slice(0,6);
const breadcrumbs={"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
 {"@type":"ListItem","position":1,"name":"Home","item":"https://tradeninety.com/"},
 {"@type":"ListItem","position":2,"name":"Currency pairs","item":"https://tradeninety.com/pairs/"},
 {"@type":"ListItem","position":3,"name":pair.label,"item":"https://tradeninety.com"+permalink}]};
---
<Layout title={title} description={description} canonical={permalink}>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)}/>
 <main class="wrap pair-page">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/pairs/">Currency pairs</a><span>›</span><span aria-current="page">{pair.label}</span></nav>
  <header class="pair-head">
   <div class="eyebrow">MONETARY POLICY RESEARCH · {pair.baseBank.short} / {pair.quoteBank.short}</div>
   <div class="headingline"><div><h1>{pair.label} Interest Rate Differential</h1><p>Will the difference between {pair.baseBank.short} and {pair.quoteBank.short} policy rates widen, narrow or remain uncertain? Follow TRADE90's conditional research assessment and source-linked evidence.</p></div><a class="otherpair" href="/pairs/">Explore all pairs →</a></div>
  </header>
  <section class="section article-section" aria-labelledby="rate-answer">
   <h2 id="rate-answer">What is the {pair.label} interest-rate difference?</h2>
   <p>The published {pair.baseBank.short} benchmark is <strong>{displayRate(pair.baseBank)}</strong> and the {pair.quoteBank.short} benchmark is <strong>{displayRate(pair.quoteBank)}</strong>. The signed {pair.base} minus {pair.quote} differential is <strong>{pair.signedBp>0?"+":""}{formatBp(pair.signedBp)} basis points</strong>.</p>
   <p>Calculation: ({formatPercent(pair.baseBank.rate)} − {formatPercent(pair.quoteBank.rate)}) × 100 = {formatBp(pair.signedBp)} basis points. {pair.base==="USD"||pair.quote==="USD" ? "The calculation uses the midpoint of the Fed’s target range." : "One percentage point equals 100 basis points."} A negative result means the quote currency has the higher benchmark; a positive result means the base currency does.</p>
   <p>These are published policy benchmarks. Check each bank’s effective date and official source below before using the comparison.</p>
   <RefreshStatus compact={true} client:visible />
   <p><a href="#policy-outlook">Explore the conditional 90-day outlook ↓</a> · <a href="/learn/what-is-interest-rate-divergence/">How interest-rate divergence works →</a></p>
  </section>
  <DivergenceHero pair={pair} model={policyModel} snapshotDate={rateSnapshot.asOf}/>
  
  <section class="comparison" aria-label={"Official "+pair.label+" policy benchmark comparison"}>
    <div class="bank-card"><div class="card-label">BASE · {pair.base}</div><h2><a href={"/central-banks/"+pair.baseBank.short.toLowerCase()+"/"}>{pair.baseBank.short} · {pair.baseBank.name}</a></h2><div class="value">{displayRate(pair.baseBank)}</div><p>{displayBenchmark(pair.baseBank)}</p>{pair.baseBank.code==="USD"&&<p>{midpointNote(pair.baseBank)}</p>}<p>Effective {reportDate(pair.baseBank.effectiveDate)}</p><a href={pair.baseBank.source} target="_blank" rel="noopener noreferrer">Official {pair.baseBank.short} rate source ↗</a></div>
    <div class="gap-card"><div class="card-label">SIGNED BASE − QUOTE GAP</div><div class="gap-value">{pair.signedBp>0?"+":""}{formatBp(pair.signedBp)} <small>bp</small></div><strong>{pair.higher==="Equal"?"Equal benchmarks":pair.higher+" has the higher selected benchmark"}</strong><p>Absolute difference: {formatBp(pair.absBp)} bp</p><p>This is not a forecast of the {pair.label} exchange rate or actual broker swap yield.</p></div>
    <div class="bank-card"><div class="card-label">QUOTE · {pair.quote}</div><h2><a href={"/central-banks/"+pair.quoteBank.short.toLowerCase()+"/"}>{pair.quoteBank.short} · {pair.quoteBank.name}</a></h2><div class="value">{displayRate(pair.quoteBank)}</div><p>{displayBenchmark(pair.quoteBank)}</p>{pair.quoteBank.code==="USD"&&<p>{midpointNote(pair.quoteBank)}</p>}<p>Effective {reportDate(pair.quoteBank.effectiveDate)}</p><a href={pair.quoteBank.source} target="_blank" rel="noopener noreferrer">Official {pair.quoteBank.short} rate source ↗</a></div>
  </section>
  <p class="data-footnote">Benchmark dataset last changed {reportDate(rateSnapshot.asOf)}. Effective dates differ by bank; a successful source check does not necessarily mean a new decision was verified. This is not live market pricing. <a href="/data-policy/">Review sources, update frequency and licensing →</a></p>
  <nav class="page-nav" aria-label="On this page"><a href="#policy-outlook">90-day outlook</a><a href="#economy">Macro analysis</a><a href="#yield-curve">Bond yields</a><a href="#decisions">Next decisions</a><a href="#research">Research articles</a><a href="#sources">Sources &amp; methodology</a></nav>
  <section class="section" id="economy"><MacroComparison client:visible base={pair.base} quote={pair.quote} initialData={{...macroData,countries:{[pair.base]:macroData.countries[pair.base],[pair.quote]:macroData.countries[pair.quote]}}}/></section>
  <YieldCurve pair={pair}/>
  <section class="section" id="decisions"><NextDecisions client:visible pair={pair}/></section>
  <section class="section article-section" id="research"><div class="eyebrow">ORIGINAL RESEARCH · EDITORIAL REVIEWED</div><h2>Latest {pair.label} research</h2>{publishedResearch.length ? <div class="research-links">{publishedResearch.slice(0,6).map(article=><a href={researchUrl(article)}><strong>{article.title}</strong><span><time datetime={article.publishedAt}>{reportDate(article.publishedAt)}</time> · {article.summary}</span></a>)}</div> : <p>Original research will appear here once the analysis, dates and primary sources are verified and approved. Explore the policy and macroeconomic evidence above in the meantime.</p>}</section>
  <details class="more-research"><summary>Central-bank guidance and policy updates <span>Expand detailed evidence</span></summary><section class="section" id="guidance"><PairGuidance pair={pair}/></section><section class="section" id="updates"><PolicyUpdates pair={pair}/></section><section class="section" id="official-releases"><OfficialPublications client:visible pair={pair}/></section></details>
  <section class="section article-section" id="sources"><div class="eyebrow">INTERPRETATION &amp; SOURCES</div><h2>What the {pair.label} policy-rate gap means</h2><p>{explanation.summary}</p><h3>What could change the relative policy outlook?</h3><p>{explanation.developments}</p><h3>Why this gap is not a trade recommendation</h3><p>{explanation.nuances}</p><p>Changes in market-implied expectations do not necessarily change official rates. The model is experimental and does not predict spot currency prices. Read the <a href="/methodology/">methodology</a> and <a href="/data-policy/">source and update policy</a>.</p><details class="source-details"><summary>View supporting bank evidence and official publications</summary><PolicyOutlook evidenceOnly={true} client:visible symbol={pair.symbol} initialData={{...policyModel,banks:{[pair.base]:policyModel.banks[pair.base],[pair.quote]:policyModel.banks[pair.quote]},pairs:{[pair.symbol]:policyModel.pairs[pair.symbol]}}}/><ul>{previous.map(item=><li><time datetime={item.publishedDate}>{reportDate(item.publishedDate)}</time> · <a href={item.source} target="_blank" rel="noopener noreferrer">{item.bank}: {item.title} ↗</a></li>)}</ul></details></section>
  <FtmoAffiliate/>
  <section class="section related"><div class="section-heading"><h2>Explore related currency pairs</h2><a href="/pairs/">All 28 pairs →</a></div><div class="related-links">{relevant.map(p=><a href={pairUrl(p.symbol)}><strong>{p.label}</strong><span>{p.signedBp>0?"+":""}{formatBp(p.signedBp)} bp</span></a>)}</div></section>
 </main>
</Layout>
<style>
.pair-page{padding-bottom:32px}
.crumbs{display:flex;align-items:center;flex-wrap:wrap;gap:9px;padding-top:20px;font-size:.75rem;color:#94a3b8}.crumbs a{color:#bfdbfe}
.pair-head{padding:23px 0 6px}.eyebrow{color:#60a5fa;font-size:.69rem;font-weight:780;letter-spacing:.1em;text-transform:uppercase}.headingline{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}.headingline h1{font-size:clamp(2rem,4.5vw,3rem);color:#f8fafc;letter-spacing:-.045em;line-height:1.14;margin:8px 0}.headingline p{color:#a5b4c8;max-width:750px;font-size:.9rem}.otherpair{flex:none;margin-top:12px;font-size:.83rem}.finder-shell{margin-top:12px;max-width:570px}.pair-switcher{margin:8px 0 15px}.switcher-label{display:block;color:#94a3b8;font-size:.76rem;font-weight:760;margin:0 0 5px}
.comparison{display:grid;grid-template-columns:1fr 1.1fr 1fr;gap:13px}
.bank-card,.gap-card{padding:19px;border-radius:14px;border:1px solid #334155;background:#111c30;min-width:0}
.card-label{color:#94a3b8;font-size:.66rem;letter-spacing:.08em;font-weight:800}.bank-card h2{font-size:.91rem;color:#e2e8f0;margin:8px 0}.value,.gap-value{font-variant-numeric:tabular-nums;letter-spacing:-.05em;font-weight:860;color:#f8fafc;font-size:2rem;margin:7px 0}.gap-card{background:#112c50;border-color:#3b82f6}.gap-value{font-size:2.25rem;color:#dbeafe}.gap-value small{font-size:.52em}.gap-card strong{font-size:.83rem;color:#bfdbfe}.bank-card p,.gap-card p{font-size:.76rem;color:#a5b4c8;margin:5px 0}.bank-card a{display:inline-block;color:#93c5fd;font-size:.75rem;margin-top:8px}
.page-nav{display:flex;flex-wrap:wrap;gap:7px;margin:21px 0 10px}.page-nav a{border:1px solid #475569;background:#162338;color:#cbd5e1;border-radius:8px;padding:8px 11px;text-decoration:none;font-weight:730;font-size:.77rem}.page-nav a:hover{border-color:#3b82f6}
.section{scroll-margin-top:90px;border:1px solid #334155;border-radius:14px;background:#101a2b;margin:20px 0;overflow:hidden}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:20px 24px 8px}.section-heading h2,.article-section h2{font-size:1.35rem;color:#f8fafc;margin:5px 0}.section-heading p{color:#a5b4c8;font-size:.81rem;max-width:750px;margin:5px 0}.article-section{padding:23px;max-width:none}.article-section p,.article-section li{color:#cbd5e1;font-size:.87rem;line-height:1.8;max-width:880px}.article-section h3{color:#e2e8f0;font-size:1.03rem;margin:21px 0 6px}.article-section li{margin:6px 0}.section.related{padding:12px 0 24px}.related-links{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:8px 24px}.related-links a{display:flex;justify-content:space-between;gap:8px;background:#182538;border:1px solid #334155;border-radius:9px;padding:12px;text-decoration:none;color:#e2e8f0}.related-links a span{color:#94a3b8;font-size:.8rem}.related-links a:hover{border-color:#3b82f6}
@media(max-width:850px){.comparison{grid-template-columns:1fr 1fr}.gap-card{grid-column:1/-1;grid-row:1}.related-links{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.pair-head{padding-top:21px}.headingline{display:block}.otherpair{display:inline-block}.comparison{grid-template-columns:1fr 1fr;gap:8px}.bank-card,.gap-card{padding:13px}.bank-card h2{font-size:.78rem;min-height:34px}.value{font-size:1.52rem}.gap-value{font-size:1.8rem}.section-heading{padding:16px 14px 8px}.article-section{padding:16px}.related-links{padding:8px 14px;grid-template-columns:1fr}.section-heading h2{font-size:1.15rem}}
.research-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}.research-links a{display:flex;flex-direction:column;gap:7px;background:#182538;border:1px solid #334155;border-radius:10px;padding:15px;text-decoration:none}.research-links a strong{color:#f8fafc}.research-links a span{font-size:.8rem;color:#a5b4c8;line-height:1.6}.research-links a:hover{border-color:#60a5fa}@media(max-width:560px){.research-links{grid-template-columns:1fr}}
.more-research{border:1px solid #334155;border-radius:12px;margin:20px 0;background:#101a2b}.more-research>summary,.source-details>summary{cursor:pointer;padding:18px 20px;color:#e2e8f0;font-weight:750;list-style-position:inside}.more-research>summary span{font-size:.76rem;color:#94a3b8;font-weight:400;margin-left:12px}.more-research[open]>summary{border-bottom:1px solid #334155}.more-research>.section{margin:12px}.source-details{margin-top:20px;border:1px solid #334155;border-radius:10px}.source-details>summary{font-size:.85rem}.source-details :global(.policy-section){margin:0}@media(max-width:560px){.more-research>summary{padding:14px}.more-research>summary span{display:block;margin:5px 0 0}.more-research>.section{margin:8px}}
</style>