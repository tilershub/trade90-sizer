---
import BaseLayout from '../layouts/BaseLayout.astro';
import FxResearchTerminal from '../components/FxResearchTerminal.svelte';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { HUBS } from '../lib/hubs';

const seoTitle = "Research Terminal for FX, Gold & Bitcoin";
const seoDescription = "Use the free native TRADE90 research terminal for live indicative FX, gold and Bitcoin prices, charts, event risk, positioning, probabilities and model validation.";
const site = Astro.site?.toString() || "https://tradeninety.com";

const featuredSlugs = [
  'risk-management/risk-of-ruin',
  'trading-plans/how-to-build-a-trading-plan',
  'psychology/why-traders-fail',
];
const allArticles = await getCollection('articles');
const byId = new Map(allArticles.map((article) => [article.id.replace(/\.mdx?$/, ''), article]));
const featured = featuredSlugs.map((slug) => byId.get(slug)).filter(Boolean);

const researchLayers = [
  {
    number: '01',
    title: 'Market facts',
    text: 'Price, volatility, market regime and cross-asset drivers are shown before any model interpretation.',
  },
  {
    number: '02',
    title: 'Evidence score',
    text: 'A comparable composite score helps you scan raw model evidence across nine markets before checking the calibrated scenarios.',
  },
  {
    number: '03',
    title: 'Scenario probabilities',
    text: 'Five-day bullish, range and bearish frequencies are displayed with sample size and confidence.',
  },
  {
    number: '04',
    title: 'Planning levels',
    text: 'Support, resistance and typical range provide context for planning—not instructions to enter a trade.',
  },
];

const workflow = [
  {
    step: 'Scan',
    title: 'Find the clearest evidence',
    text: 'Compare all nine markets from one table, then select the instrument that deserves deeper research.',
    href: '#terminal',
    link: 'Use the terminal',
  },
  {
    step: 'Plan',
    title: 'Define risk before entry',
    text: 'Turn your thesis into invalidation, risk percentage and position size before you place an order.',
    href: '/tools/position-size-calculator/',
    link: 'Size the position',
  },
  {
    step: 'Review',
    title: 'Measure the decision',
    text: 'Record the trade in R-multiples and review whether you followed the plan—not only whether it won.',
    href: '/journal/',
    link: 'Open the journal',
  },
];

const supportingTools = [
  { href: '/tools/position-size-calculator/', name: 'Position Size', desc: 'Calculate risk-based size' },
  { href: '/risk-reward-calculator/', name: 'Risk / Reward', desc: 'Map reward against risk' },
  { href: '/tools/trading-plan-builder/', name: 'Plan Builder', desc: 'Write your execution rules' },
  { href: '/today/', name: "Today's Desk", desc: 'Run the session checklist' },
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "TRADE90 Multi-Asset Research Terminal",
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web",
  url: site,
  description: seoDescription,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords={["market research terminal", "forex research", "XAUUSD research", "BTCUSD research", "FX market scanner"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} slot="head-extra" />

  <div id="trade90-home" class="bg-white text-slate-950">
    <!-- Terminal-first hero -->
    <section class="relative overflow-hidden border-b border-emerald-100 bg-[radial-gradient(circle_at_80%_0%,_rgba(16,185,129,0.16),_transparent_34%),linear-gradient(180deg,#f8fffc_0%,#ffffff_100%)]">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-emerald-400 to-transparent"></div>
      <div class="max-w-7xl mx-auto px-5 sm:px-6 pt-14 pb-12 md:pt-20 md:pb-16">
        <div class="grid lg:grid-cols-[minmax(0,1fr)_21rem] gap-10 lg:gap-14 items-end">
          <div class="max-w-4xl">
            <div class="inline-flex items-center gap-2.5 rounded-full border border-emerald-200 bg-white/80 px-3.5 py-2 shadow-sm mb-6">
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-50"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-600"></span>
              </span>
              <span class="text-[10px] sm:text-[11px] font-black uppercase tracking-[0.22em] text-emerald-900">Free multi-asset research workspace</span>
            </div>

            <h1 class="text-[2.75rem] sm:text-6xl lg:text-7xl font-black tracking-[-0.055em] leading-[0.9] text-slate-950 mb-6">
              See the market.<br />
              <span class="text-emerald-700">Then plan the trade.</span>
            </h1>

            <p class="max-w-2xl text-base sm:text-lg text-slate-600 leading-relaxed mb-8">
              One clear research terminal for seven major FX pairs, gold and Bitcoin. Compare the evidence, inspect the scenarios and define your risk—without confusing a model with a signal.
            </p>

            <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
              <a href="#terminal" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-6 py-3.5 text-xs font-black uppercase tracking-[0.15em] text-white shadow-lg shadow-emerald-900/10 transition hover:bg-emerald-800 focus:outline-none focus:ring-4 focus:ring-emerald-200">
                Open the terminal <span aria-hidden="true">↓</span>
              </a>
              <a href="#how-it-works" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[0.15em] text-slate-700 transition hover:border-emerald-500 hover:text-emerald-800 focus:outline-none focus:ring-4 focus:ring-emerald-100">
                See how to use it
              </a>
            </div>
          </div>

          <aside class="rounded-2xl border border-slate-200 bg-white/90 p-5 shadow-xl shadow-slate-900/5" aria-label="Terminal coverage">
            <p class="text-[10px] font-black uppercase tracking-[0.25em] text-emerald-700 mb-4">Inside the terminal</p>
            <dl class="grid grid-cols-3 lg:grid-cols-1 gap-3 lg:gap-0">
              <div class="lg:flex lg:items-center lg:justify-between lg:border-b lg:border-slate-100 lg:pb-3">
                <dt class="text-xs text-slate-500">Markets</dt>
                <dd class="text-xl font-black text-slate-950">9</dd>
              </div>
              <div class="lg:flex lg:items-center lg:justify-between lg:border-b lg:border-slate-100 lg:py-3">
                <dt class="text-xs text-slate-500">Scenario window</dt>
                <dd class="text-xl font-black text-slate-950">5D</dd>
              </div>
              <div class="lg:flex lg:items-center lg:justify-between lg:pt-3">
                <dt class="text-xs text-slate-500">Access</dt>
                <dd class="text-xl font-black text-emerald-700">Free</dd>
              </div>
            </dl>
            <p class="mt-4 border-t border-slate-100 pt-4 text-xs leading-relaxed text-slate-500">
              No account required. Indicative prices refresh every five minutes; the full research model refreshes every six hours.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <!-- The product -->
    <section id="terminal" class="scroll-mt-24 bg-slate-50 px-3 py-8 sm:px-6 sm:py-12 md:py-16">
      <div class="max-w-7xl mx-auto">
        <div class="mb-6 flex flex-col gap-4 px-2 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="mb-2 text-[10px] font-black uppercase tracking-[0.3em] text-emerald-700">TRADE90 Terminal</p>
            <h2 class="text-2xl sm:text-3xl font-black tracking-[-0.035em] text-slate-950">The research is the homepage.</h2>
          </div>
          <p class="max-w-xl text-sm leading-relaxed text-slate-600 md:text-right">
            Start with the scanner, then open native charts, event risk, positioning, model audit and validation without leaving Trade90.
          </p>
        </div>

        <nav aria-label="Market research pages" class="flex flex-wrap gap-5 mb-5 text-base text-emerald-800">
          <a class="underline py-3" href="/research/xauusd/">Gold research</a>
          <a class="underline py-3" href="/research/btcusd/">Bitcoin research</a>
          <a class="underline py-3" href="/research/usdjpy/">USD/JPY research</a>
        </nav>
        <FxResearchTerminal client:load />

        <div class="mt-5 flex flex-col gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm leading-relaxed text-amber-950">
            <strong>Research, not a trade signal.</strong> Confirm current prices and event data with your broker, then apply your own risk limits.
          </p>
          <span class="shrink-0 rounded-full border border-emerald-200 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.12em] text-emerald-800">
            Fully native terminal
          </span>
        </div>
      </div>
    </section>

    <!-- Explain the evidence -->
    <section id="how-it-works" class="scroll-mt-24 border-y border-slate-200 bg-white px-5 py-16 sm:px-6 md:py-24">
      <div class="max-w-7xl mx-auto">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="mb-3 text-[10px] font-black uppercase tracking-[0.3em] text-emerald-700">Transparent by design</p>
            <h2 class="mb-5 text-3xl sm:text-4xl font-black tracking-[-0.045em] leading-tight text-slate-950">Know what is data—and what is interpretation.</h2>
            <p class="text-base leading-relaxed text-slate-600">
              TRADE90 keeps observed facts, model judgement, historical frequencies and trade-planning context separate. That makes the terminal useful without pretending uncertainty has disappeared.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {researchLayers.map((layer) => (
              <article class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
                <span class="mb-8 block text-xs font-black text-emerald-700">{layer.number}</span>
                <h3 class="mb-2 text-lg font-black tracking-tight text-slate-950">{layer.title}</h3>
                <p class="text-sm leading-relaxed text-slate-600">{layer.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Workflow -->
    <section class="bg-slate-950 px-5 py-16 text-white sm:px-6 md:py-24">
      <div class="max-w-7xl mx-auto">
        <div class="mb-10 max-w-2xl">
          <p class="mb-3 text-[10px] font-black uppercase tracking-[0.3em] text-emerald-400">One disciplined workflow</p>
          <h2 class="mb-4 text-3xl sm:text-4xl font-black tracking-[-0.045em]">Research is only useful when it improves the decision.</h2>
          <p class="text-sm sm:text-base leading-relaxed text-slate-400">Move from evidence to a written risk plan, then review your execution with the same discipline.</p>
        </div>

        <div class="grid gap-4 lg:grid-cols-3">
          {workflow.map((item, index) => (
            <article class="group rounded-2xl border border-slate-800 bg-slate-900/65 p-6 transition hover:border-emerald-500/50">
              <div class="mb-8 flex items-center justify-between">
                <span class="text-[10px] font-black uppercase tracking-[0.25em] text-emerald-400">{item.step}</span>
                <span class="text-sm font-black text-slate-600">0{index + 1}</span>
              </div>
              <h3 class="mb-3 text-xl font-black tracking-tight text-white">{item.title}</h3>
              <p class="mb-6 text-sm leading-relaxed text-slate-400">{item.text}</p>
              <a href={item.href} class="text-xs font-black uppercase tracking-[0.12em] text-emerald-400 transition group-hover:text-emerald-300">{item.link} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Supporting tools -->
    <section class="bg-slate-50 px-5 py-16 sm:px-6 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="mb-3 text-[10px] font-black uppercase tracking-[0.3em] text-emerald-700">Supporting tools</p>
            <h2 class="text-3xl font-black tracking-[-0.04em] text-slate-950">Complete the process.</h2>
          </div>
          <a href="/tools/" class="text-xs font-black uppercase tracking-[0.12em] text-emerald-800 hover:text-emerald-950">View all tools <span aria-hidden="true">→</span></a>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {supportingTools.map((tool) => (
            <a href={tool.href} class="group flex min-h-36 flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-400 hover:shadow-lg hover:shadow-slate-900/5">
              <span class="text-2xl text-emerald-600 transition group-hover:translate-x-1" aria-hidden="true">↗</span>
              <span>
                <strong class="block text-base font-black text-slate-950">{tool.name}</strong>
                <span class="mt-1 block text-xs text-slate-500">{tool.desc}</span>
              </span>
            </a>
          ))}
        </div>

        <nav class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-6" aria-label="Instrument position size calculators">
          <h3 class="text-lg font-bold text-slate-950">Position size calculators by market</h3>
          <p class="mt-2 text-base leading-relaxed text-slate-600">Choose your instrument to calculate position size from your account risk and stop-loss distance.</p>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {[
              { slug: 'xauusd', name: 'Gold (XAUUSD) lot size calculator' },
              { slug: 'eurusd', name: 'EUR/USD position size calculator' },
              { slug: 'gbpusd', name: 'GBP/USD position size calculator' },
              { slug: 'usdjpy', name: 'USD/JPY position size calculator' },
              { slug: 'nas100', name: 'NAS100 position size calculator' },
              { slug: 'btcusd', name: 'Bitcoin position size calculator' },
            ].map((market) => (
              <li><a class="inline-flex min-h-12 items-center text-base font-semibold text-emerald-800 underline decoration-emerald-200 underline-offset-4 hover:decoration-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4" href={`/calculator/${market.slug}/`}>{market.name}</a></li>
            ))}
          </ul>
          <a class="mt-4 inline-flex min-h-12 items-center text-base font-semibold text-emerald-800 underline underline-offset-4" href="/calculator/">Browse all instrument calculators</a>
        </nav>
      </div>
    </section>

    <!-- Education is now supporting content -->
    <section class="border-t border-slate-200 bg-white px-5 py-16 sm:px-6 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="mb-10 max-w-2xl">
          <p class="mb-3 text-[10px] font-black uppercase tracking-[0.3em] text-emerald-700">Build the judgement behind the tool</p>
          <h2 class="mb-3 text-3xl font-black tracking-[-0.04em] text-slate-950">Start with these three guides.</h2>
          <p class="text-sm leading-relaxed text-slate-600">The terminal organizes evidence. These guides help you decide how much risk that evidence deserves.</p>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          {featured.map((article) => {
            const path = article.id.replace(/\.mdx?$/, '');
            const hub = HUBS[article.data.hub];
            return (
              <a href={`/${path}/`} class="group rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-emerald-400 hover:shadow-lg hover:shadow-slate-900/5">
                <div class="mb-6 flex items-center justify-between">
                  <span class={`text-[9px] font-black uppercase tracking-[0.16em] ${hub.accent}`}>{hub.shortName}</span>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">{article.data.reading_time} min</span>
                </div>
                <h3 class="mb-3 text-lg font-black leading-snug tracking-tight text-slate-950 transition group-hover:text-emerald-800">{article.data.title}</h3>
                <p class="text-sm leading-relaxed text-slate-600">{article.data.description}</p>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <div class="border-t border-slate-800 bg-slate-950">
      <Newsletter />
    </div>
  </div>
</BaseLayout>

<style is:global>
  #trade90-home p { opacity: 1; }
  #trade90-home .text-slate-950 { color: #020617 !important; }
  #trade90-home .text-slate-600 { color: #475569 !important; }
  #trade90-home .text-slate-500 { color: #64748b !important; }
  #trade90-home .text-slate-400 { color: #94a3b8 !important; }
  #trade90-home .text-emerald-700 { color: #047857 !important; }
  #trade90-home .text-emerald-800 { color: #065f46 !important; }
  @media (prefers-reduced-motion: reduce) {
    #trade90-home .animate-ping { animation: none; }
  }
</style>
