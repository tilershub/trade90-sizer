---
import Trade90V2Layout from "../layouts/Trade90V2Layout.astro";
import Trade90Divergence from "../components/Trade90Divergence.svelte";
import Trade90PolicyUpdates from "../components/Trade90PolicyUpdates.svelte";
import snapshot from "../data/trade90-policy-snapshot.json";
---
<Trade90V2Layout
 title="Central Bank Rate Divergence — 28 Forex Pair Comparisons"
 description="Compare current central-bank policy rates and interest-rate differences for 28 major forex currency pairs. Explore rate gap rankings, sourced decisions, expected-rate data availability and individual pair details."
 canonical="/">
 <main class="wrap">
   <div class="page-intro">
     <div class="eyebrow">Official interest rates · Forex rate comparisons</div>
     <h1>Central Bank Rate Divergence</h1>
     <p>See the policy-rate gap across 28 forex pairs. Compare eight central banks, understand the calculation, and follow what has actually changed—without unsupported trading signals.</p>
     <nav class="section-shortcuts" aria-label="Jump to policy research sections">
       <a href="#policy-divergences">Key divergences <span aria-hidden="true">↓</span></a>
       <a href="#policy-outlook">Policy outlook &amp; guidance <span aria-hidden="true">↓</span></a>
       <a href="#next-decisions">Next decisions <span aria-hidden="true">↓</span></a>
     </nav>
   </div>
   <Trade90Divergence client:load snapshot={snapshot} />
   <Trade90PolicyUpdates client:load compact={true} />
   <section class="learnstart" aria-labelledby="learn-title">
     <div class="learnheader">
       <div><span class="eyebrow">Learn the fundamentals</span><h2 id="learn-title">Understand what the gap means</h2><p>Rate differences provide monetary-policy context, not a prediction of price direction. These guides explain how to interpret them.</p></div>
       <a href="/learn/">All guides →</a>
     </div>
     <div class="learncards">
       <a class="linkcard" href="/learn/what-is-interest-rate-divergence/"><strong>What is interest rate divergence in forex?</strong><p>Understand the difference between current central-bank rates and expected policy paths.</p><span>Read guide →</span></a>
       <a class="linkcard" href="/learn/expected-rate-gaps/"><strong>How do markets price expected interest rates?</strong><p>Learn why rate expectations can move even when official policy rates stay unchanged.</p><span>Read guide →</span></a>
       <a class="linkcard" href="/learn/high-interest-rates-currency-strength/"><strong>Do higher interest rates mean a stronger currency?</strong><p>Understand carry, exchange-rate risk and why the largest gap is not automatically the best trade.</p><span>Read guide →</span></a>
     </div>
   </section>
 </main>
</Trade90V2Layout>
<style>
.section-shortcuts{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
.section-shortcuts a{border:1px solid #335b53;background:#11352d;color:#baf7dc;border-radius:9px;padding:8px 12px;font-size:.78rem;font-weight:720;text-decoration:none}
.section-shortcuts a:hover{background:#155241;color:#fff}
.learnstart{padding:40px 0 20px}
.learnheader{display:flex;align-items:center;justify-content:space-between;gap:20px}
.learnheader .eyebrow{font-size:.68rem;font-weight:800;letter-spacing:.1em;color:#34d399;text-transform:uppercase}
.learnheader h2{font-size:1.65rem;letter-spacing:-.035em;margin:5px 0}
.learnheader p{color:#94a3b8;font-size:.88rem;max-width:690px;margin:5px 0}
.learnheader>a{white-space:nowrap}
.learncards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:17px 0}
.learncards strong{font-size:1.05rem;line-height:1.3;display:block}
.learncards span{color:#6ee7b7;font-weight:700;font-size:.8rem}
@media(max-width:760px){.learncards{grid-template-columns:1fr}.learnheader{align-items:start}.learnheader a{font-size:.8rem}}
</style>
