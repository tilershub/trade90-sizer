---
import Layout from "../layouts/Trade90V2Layout.astro";
import PairFinder from "../components/Trade90PairFinder.svelte";
import {allTrade90Pairs,majors,pairUrl} from "../lib/trade90-v3.js";
import policyOutlook from "../../public/data/policy-outlook.json";
const outlookEntries=allTrade90Pairs.map(pair=>({pair,outlook:policyOutlook.pairs?.[pair.symbol]})).filter(item=>item.outlook);
const outlookGeneratedAt=policyOutlook.generatedAt;
const outlookExpiry=outlookEntries.reduce((earliest,item)=>!earliest||item.outlook.expiresAt<earliest?item.outlook.expiresAt:earliest,null);
const displayedOutlooks=outlookEntries.filter(item=>Date.parse(item.outlook.expiresAt)>Date.now()).sort((a,b)=>{const status=x=>({widening:0,narrowing:1,unclear:2,uncertain:2,unavailable:3}[x.outlook.state]??3);const tier=x=>({verified_market:5,reviewed_qualitative:4,automated_provisional:3,exploratory_macro:2}[x.outlook.evidenceTier]||0);return status(a)-status(b)||tier(b)-tier(a)||a.pair.symbol.localeCompare(b.pair.symbol)});
const currentOutlooks=outlookEntries.filter(item=>Date.parse(item.outlook.expiresAt)>Date.now());
const unavailablePairs=allTrade90Pairs.filter(pair=>{const o=policyOutlook.pairs?.[pair.symbol];return !o||o.state==="unavailable"||!Number.isFinite(Date.parse(o.expiresAt))||Date.parse(o.expiresAt)<=Date.now();});
const marketCoverage=policyOutlook.marketCoverage||{currencyPairCount:0,totalPairs:28,reason:'Market-implied policy paths have not been verified'};
const reviewedCount=currentOutlooks.filter(item=>item.outlook.evidenceTier==='reviewed_qualitative').length;
const macroCount=currentOutlooks.filter(item=>item.outlook.evidenceTier==='exploratory_macro').length;
const automaticCount=currentOutlooks.filter(item=>item.outlook.evidenceTier==='automated_provisional').length;
const automaticCoverage=policyOutlook.automatedPolicyCoverage||{assessed:0,total:8,verifiedDecisions:0,unverifiedNewDecisions:0};
const outlookCounts={widening:currentOutlooks.filter(item=>item.outlook.state==="widening").length,narrowing:currentOutlooks.filter(item=>item.outlook.state==="narrowing").length,uncertain:currentOutlooks.filter(item=>item.outlook.state==="uncertain"||item.outlook.state==="unclear").length};
---
<Layout title="Interest Rate Divergence Dashboard for 28 Forex Pairs" description="TRADE90 compares central-bank interest-rate differentials across 28 forex pairs, with source-dated macro evidence and conditional 90-day widening or narrowing outlooks." canonical="/">
<main class="wrap home">
 <section class="hero" aria-labelledby="hero-heading">
  <div class="hero-content">
   <div class="eyebrow">TRADE90 · INTEREST RATE DIVERGENCE DASHBOARD · 28 FX PAIRS</div>
   <h1 id="hero-heading">Which forex interest-rate gaps could <em>widen or narrow?</em></h1>
   <p>TRADE90 compares eight central banks across 28 currency pairs. Start with the current policy-rate gap, then examine our conditional 90-day divergence assessment and the dated economic evidence behind it. This is policy research, not an FX price prediction.</p>
   <p><a class="primary-action" href="#outlook">Explore 90-day divergence →</a> <a href="/pairs/">Compare all 28 pairs →</a></p>
   <PairFinder client:load pairs={majors.concat(allTrade90Pairs.filter(p=>p.base!=="USD" && p.quote!=="USD"))} limit={7}/>
   <div class="popular"><span>Explore popular pairs:</span>{["EURUSD","GBPUSD","USDJPY","AUDUSD"].map(symbol=><a href={pairUrl(symbol)}>{symbol.slice(0,3)}/{symbol.slice(3)}</a>)}<a href="/pairs/">All 28 →</a></div>
  </div>
 </section>
 <section class="block outlook-block" id="outlook" aria-labelledby="outlook-heading"><div class="section-head"><div><div class="eyebrow">TRADE90 EXPERIMENTAL RESEARCH · 90 DAYS</div><h2 id="outlook-heading">90-day policy-rate divergence outlook</h2><p>The model shows supported Widening and Narrowing research scenarios even when market-implied policy rates are unavailable. Reviewed policy scenarios, automated provisional policy assessments and exploratory macro-pressure screens are labelled separately from verified market pricing. These are not calibrated forecasts.</p></div><a href="/pairs/">Explore all 28 pairs →</a></div>
 <div class="outlook-summary" role="group" aria-label="Filter 90-day research scenarios by direction">
  <button type="button" class="outlook-filter" data-outlook-filter="widening" aria-pressed="true" aria-controls="outlook-pair-results">↗ <span>Widening</span> <strong data-filter-count="widening">{outlookCounts.widening}</strong></button>
  <button type="button" class="outlook-filter" data-outlook-filter="narrowing" aria-pressed="false" aria-controls="outlook-pair-results">↘ <span>Narrowing</span> <strong data-filter-count="narrowing">{outlookCounts.narrowing}</strong></button>
  <button type="button" class="outlook-filter" data-outlook-filter="unclear" aria-pressed="false" aria-controls="outlook-pair-results">↔ <span>Uncertain</span> <strong data-filter-count="unclear">{outlookCounts.uncertain}</strong></button>
  <button type="button" class="outlook-filter" data-outlook-filter="all" aria-pressed="false" aria-controls="outlook-pair-results"><span>All pairs</span> <strong data-filter-count="all">{displayedOutlooks.length}</strong></button>
 </div>
 <p class="outlook-filter-result" id="outlook-filter-result" role="status" aria-live="polite">Showing {outlookCounts.widening} Widening scenarios</p>
 <div class="outlook-grid" id="outlook-pair-results" data-featured-outlooks>{displayedOutlooks.map(({pair,outlook})=><a class="outlook-card" data-outlook-card data-outlook-state={outlook.state==="uncertain"?"unclear":outlook.state} data-expires-at={outlook.expiresAt} hidden={outlook.state!=="widening"} href={pairUrl(pair.symbol)}><strong>{pair.label}</strong><span class:list={["outlook-state",outlook.state]}><span aria-hidden="true">{outlook.state==="widening"?"↗":outlook.state==="narrowing"?"↘":"↔"}</span> {outlook.label}</span><small>{outlook.state==="widening"||outlook.state==="narrowing"?(outlook.evidenceTier==="exploratory_macro"?"Exploratory macro screen · ":outlook.evidenceTier==="reviewed_qualitative"?"Reviewed policy scenario · ":outlook.evidenceTier==="automated_provisional"?"Automated provisional policy screen · ":"Market-priced scenario · ")+outlook.signedDirection:"Direction not established"}</small></a>)}</div>
 <p class="outlook-empty" data-outlook-empty hidden>No current pairs match this category. <a href="/pairs/">Browse all 28 pair pages →</a></p>
 <noscript><p class="minor">Filters require JavaScript. <a href="/pairs/">Browse all 28 pair pages →</a></p></noscript>
 <p class="minor" data-outlook-expiry-notice hidden>These model assessments have expired. Open a pair page for the latest validated outlook and underlying evidence.</p>
 <p class="minor">Evidence: {reviewedCount} reviewed-policy, {automaticCount} automated provisional and {macroCount} exploratory macro scenarios. Licensed 3M rate coverage: {marketCoverage.currencyPairCount}/{marketCoverage.totalPairs}. These are research scenarios, not validated forecasts. <a href="/data-policy/">Research updates, source coverage and verification details →</a></p>
 <p class="minor">Model generated <time datetime={outlookGeneratedAt}>{new Date(outlookGeneratedAt).toLocaleString("en-GB",{timeZone:"UTC",dateStyle:"medium",timeStyle:"short"})} UTC</time> · Earliest pair validity expiry {outlookExpiry?new Date(outlookExpiry).toLocaleString("en-GB",{timeZone:"UTC",dateStyle:"medium",timeStyle:"short"})+" UTC":"not available"} · <a href="/methodology/">Methodology and limitations</a>. Generation is automated; it is not a new manual verification of underlying publications.</p></section>
 <section class="home-daily" aria-labelledby="daily-heading">
  <div><div class="eyebrow">YOUR DAILY RESEARCH ROUTINE</div><h2 id="daily-heading">What changed for your currency pairs?</h2><p>Review changes in policy outlooks, source-dated macroeconomic evidence and upcoming decisions in one place. An automated refresh alone does not mean the outlook changed.</p></div>
  <a href="/daily/">Open daily dashboard →</a>
 </section>
 <section class="block" aria-labelledby="guides-heading">
  <div class="section-head"><div><h2 id="guides-heading">Understand the rates behind your currency pair</h2><p>Start with the calculation, then check the economic evidence and its limits.</p></div></div>
  <div class="guides">
   <a href="/learn/what-is-interest-rate-divergence/"><strong>What is an interest-rate differential?</strong><span>Understand signed gaps, basis points and how central-bank policies can diverge.</span></a>
   <a href="/learn/forex-fundamental-analysis/"><strong>A forex fundamental analysis checklist</strong><span>Compare rates, inflation, employment and growth across both sides of a pair.</span></a>
   <a href="/learn/high-interest-rates-currency-strength/"><strong>Does a higher rate mean a stronger currency?</strong><span>Learn why a policy-rate advantage alone does not establish an exchange-rate forecast.</span></a>
  </div>
 </section>
 <nav class="home-resources" aria-label="More TRADE90 research"><a href="/rate-gaps/">Compare official rate gaps →</a><a href="/decisions/">Central-bank calendar →</a><a href="/central-banks/">Official policy publications →</a><a href="/learn/">Research guides →</a><a href="/methodology/">Methodology →</a><a href="/data-policy/">Data update status →</a></nav>
</main>
<script is:inline>
(() => {
 const container=document.getElementById("outlook-pair-results");
 if(!container)return;
 const cards=[...container.querySelectorAll("[data-outlook-card]")];
 const controls=[...document.querySelectorAll("[data-outlook-filter]")];
 const message=document.getElementById("outlook-filter-result");
 const empty=document.querySelector("[data-outlook-empty]");
 const expiredNote=document.querySelector("[data-outlook-expiry-notice]");
 let selected="widening";
 const valid=card=>{const expiry=Date.parse(card.getAttribute("data-expires-at")||"");return Number.isFinite(expiry)&&expiry>Date.now()};
 function render(){
  const validCards=cards.filter(valid);
  const counts={
   all:validCards.length,
   widening:validCards.filter(card=>card.dataset.outlookState==="widening").length,
   narrowing:validCards.filter(card=>card.dataset.outlookState==="narrowing").length,
   unclear:validCards.filter(card=>card.dataset.outlookState==="unclear").length
  };
  for(const [category,count] of Object.entries(counts)){
   const node=document.querySelector('[data-filter-count="'+category+'"]');
   if(node)node.textContent=String(count);
  }
  for(const button of controls)button.setAttribute("aria-pressed",String(button.dataset.outlookFilter===selected));
  let shown=0;
  for(const card of cards){
   const show=valid(card)&&(selected==="all"||card.dataset.outlookState===selected);
   card.hidden=!show;
   if(show)shown++;
  }
  const names={widening:"Widening",narrowing:"Narrowing",unclear:"Uncertain",all:"All"};
  if(message)message.textContent="Showing "+shown+" "+names[selected]+(selected==="all"?" current pairs":selected==="unclear"?" pairs":" scenarios");
  if(empty)empty.hidden=shown!==0||validCards.length===0;
  if(expiredNote)expiredNote.hidden=validCards.length>0;
 }
 for(const button of controls)button.addEventListener("click",()=>{selected=button.dataset.outlookFilter;render()});
 render();
 setInterval(render,300000);
})();
</script>
</Layout>
<style>
.home{padding:0 0 24px}
.hero{padding:40px 0 26px;position:relative}.primary-action{display:inline-block;padding:11px 15px;background:#2563eb;color:#fff!important;border-radius:9px;text-decoration:none;font-weight:800;margin-right:14px}.primary-action:hover{background:#1d4ed8}.hero-content{position:relative;z-index:1;max-width:950px}.hero .eyebrow,.block .eyebrow{font-size:.7rem;letter-spacing:.1em;color:#60a5fa;font-weight:830}.hero h1{font-size:clamp(2.45rem,5.3vw,4.15rem);font-weight:860;letter-spacing:-.055em;line-height:1.1;margin:15px 0 18px;color:#f8fafc;max-width:900px}.hero h1 em{font-style:normal;color:#93c5fd}.hero p{font-size:1.03rem;line-height:1.68;color:#b8c7d7;max-width:760px;margin:0 0 27px}.hero p strong{font-weight:650;color:#cbd5e1}
.popular{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin:16px 0}.popular span{font-size:.77rem;color:#a5b4c8}.popular a{border:1px solid #334155;border-radius:7px;color:#bfdbfe;text-decoration:none;padding:6px 9px;font-size:.76rem}.popular a:hover{border-color:#3b82f6}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:22px 0 42px}.metric{border:1px solid #334155;background:#111c30;border-radius:13px;padding:19px;text-decoration:none;display:flex;flex-direction:column;gap:7px;color:#e2e8f0}.metric:hover{border-color:#3b82f6}.metric span:first-child{font-size:.77rem;color:#a5b4c8}.metric strong{font-size:1.4rem;letter-spacing:-.025em;color:#f8fafc}.metric strong small{font-size:.65em}.metric span:last-child{font-size:.73rem;color:#bfdbfe}
.block{padding:26px 0 30px;border-top:1px solid #334155}.section-head{display:flex;justify-content:space-between;align-items:end;gap:14px;margin-bottom:20px}.section-head h2{font-size:clamp(1.35rem,2.8vw,1.75rem);margin:6px 0;color:#f8fafc;letter-spacing:-.035em}.section-head p{font-size:.84rem;color:#a5b4c8;margin:3px 0;max-width:770px}.section-head>a{color:#93c5fd;white-space:nowrap;font-size:.82rem}
.pair-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}.pair-card{display:block;border:1px solid #334155;border-radius:13px;padding:18px;background:#111c30;text-decoration:none;color:#f8fafc}.pair-card:hover{border-color:#3b82f6;background:#152b32}.pair-card strong{display:block;font-size:1.6rem;letter-spacing:-.045em;margin:17px 0}.pair-top{display:flex;justify-content:space-between;gap:8px;font-size:.66rem;color:#a5b4c8}.pair-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px;font-weight:770;color:#bfdbfe;font-size:.84rem}.pair-bottom small{font-weight:400;color:#94a3b8}
.minor{color:#94a3b8;font-size:.75rem;margin:15px 0 0;line-height:1.65}
.decision-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px}.decision{display:flex;flex-direction:column;gap:8px;border:1px solid #334155;background:#111c30;padding:17px;border-radius:12px;text-decoration:none;color:#f8fafc}.decision span{color:#bfdbfe;font-size:.78rem;font-weight:760}.decision strong{font-size:1.2rem}.decision small{color:#a5b4c8}
.guides{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}.guides a{padding:21px;background:#111c30;border:1px solid #334155;border-radius:12px;display:flex;flex-direction:column;gap:12px;text-decoration:none;color:#f8fafc}.guides a:hover{border-color:#3b82f6}.guides strong{font-size:.99rem}.guides span{font-size:.77rem;color:#a5b4c8}
#policy :global(.policy-section){margin:0}#policy :global(.policy-header){display:none}#policy :global(.collection-note){margin-top:0}
@media(max-width:850px){.pair-grid{grid-template-columns:repeat(2,1fr)}.decision-grid{grid-template-columns:repeat(2,1fr)}.metrics{grid-template-columns:1fr 1fr}.metrics .metric:last-child{grid-column:1/-1}}
@media(max-width:570px){.hero{padding:33px 0 20px}.hero h1{font-size:2.28rem}.hero p{font-size:.9rem}.metrics{grid-template-columns:1fr;margin:14px 0 25px}.metrics .metric:last-child{grid-column:auto}.metric{padding:14px}.section-head{display:block}.section-head>a{display:inline-block;margin-top:10px}.pair-grid{grid-template-columns:1fr 1fr;gap:7px}.pair-card{padding:11px}.pair-card strong{font-size:1.22rem}.pair-top{font-size:.59rem;display:block}.pair-top span:last-child{display:none}.pair-bottom{display:block;font-size:.76rem}.pair-bottom span:last-child{display:block;margin-top:8px}.decision-grid{grid-template-columns:1fr 1fr;gap:7px}.decision{padding:12px}.decision strong{font-size:1rem}.guides{grid-template-columns:1fr}.block{padding:22px 0}}
.outlook-block{padding-top:28px}.outlook-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-bottom:12px}.outlook-filter{display:flex;gap:7px;align-items:center;justify-content:center;cursor:pointer;text-align:center;padding:12px 10px;min-height:48px;background:#111c30;color:#cbd5e1;border:1px solid #334155;border-radius:10px;font-weight:650;font-size:.84rem}.outlook-filter strong{color:#f8fafc;font-variant-numeric:tabular-nums}.outlook-filter:hover{border-color:#60a5fa}.outlook-filter[aria-pressed="true"]{background:#1d3a59;color:#f8fafc;border-color:#60a5fa;box-shadow:inset 0 0 0 1px #60a5fa}.outlook-filter-result{font-size:.83rem;color:#cbd5e1;margin:0 0 14px}.outlook-empty{padding:14px 0;color:#cbd5e1;font-size:.84rem}.outlook-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.outlook-card{display:flex;flex-direction:column;gap:8px;min-width:0;padding:13px;background:#111c30;border:1px solid #334155;border-radius:11px;text-decoration:none;color:#f8fafc}.outlook-card:hover{border-color:#60a5fa}.outlook-card strong{font-size:1.03rem}.outlook-card small{font-size:.7rem;color:#94a3b8}.outlook-state{font-size:.75rem;color:#cbd5e1}.outlook-state.widening{color:#6ee7b7}.outlook-state.narrowing{color:#fda4af}.outlook-state.uncertain{color:#fcd34d}@media(max-width:850px){.outlook-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:570px){.outlook-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.outlook-card{padding:11px}.outlook-card strong{font-size:.96rem}.outlook-block{padding-top:20px}}
.outlook-state span{font-size:1.4rem;font-weight:900;vertical-align:middle;margin-right:4px}.secondary-home{content-visibility:auto;contain-intrinsic-size:auto 500px}@media(max-width:570px){.outlook-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.outlook-card small{line-height:1.4}}
.home-daily{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:30px 0;border-top:1px solid #334155}.home-daily h2{font-size:clamp(1.3rem,3vw,1.8rem);color:#f8fafc;margin:8px 0}.home-daily p{font-size:.85rem;color:#a5b4c8;max-width:660px;line-height:1.6}.home-daily>a{flex:none;color:#bfdbfe;font-weight:750;font-size:.86rem}.home-resources{display:flex;flex-wrap:wrap;gap:10px 22px;border-top:1px solid #334155;padding:22px 0 12px}.home-resources a{font-size:.8rem;color:#93c5fd}.outlook-card[hidden]{display:none!important}@media(max-width:570px){.home-daily{display:block}.home-daily>a{display:inline-block;margin-top:8px}.home-resources{gap:13px 18px}}
@media(max-width:650px){.outlook-summary{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.outlook-filter{padding:11px 7px;font-size:.8rem}.home-resources{padding-bottom:6px}}
:global(.home + .footer){margin-top:0}
:global(html[data-theme="light"] .home .outlook-filter){background:#fff;color:#334155;border-color:#cbd5e1}
:global(html[data-theme="light"] .home .outlook-filter[aria-pressed="true"]){background:#dbeafe;color:#1e3a8a;border-color:#2563eb}
:global(html[data-theme="light"] .home .outlook-filter strong){color:#0f172a}
:global(html[data-theme="light"] .home .outlook-filter-result),:global(html[data-theme="light"] .home .outlook-empty){color:#475569}
</style>