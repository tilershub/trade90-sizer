---
import Layout from "../../layouts/Trade90V2Layout.astro";
import {officialPolicyDecisionCalendar,decisionCalendarReviewedAt,officialDecisionSources} from "../../data/trade90-decision-calendar.js";
import {reportDate,allTrade90Pairs,pairUrl} from "../../lib/trade90-v3.js";
const referenceDate=new Date().toISOString().slice(0,10);
const next=[...officialPolicyDecisionCalendar].filter(e=>e.date>=referenceDate).sort((a,b)=>a.date.localeCompare(b.date));
---
<Layout title="Central Bank Interest Rate Decision Calendar" description="Official monetary policy decision calendars for the Fed, ECB, BoE, BoJ, RBA, RBNZ, BoC and SNB, with dated source links and relevant forex currency pairs." canonical="/decisions/">
<main class="wrap">
<header class="page-intro"><div class="eyebrow">Eight official central banks</div><h1>Next Major Interest Rate Decisions</h1><p>Upcoming central-bank announcements, their schedules and the forex pairs affected by those currencies. These are verified scheduled meeting dates—not predictions of a rate change or market reaction.</p><p class="reviewed">Calendar last curated: <time datetime={decisionCalendarReviewedAt}>{reportDate(decisionCalendarReviewedAt)}</time>. Meetings can be changed or added without notice. Always verify with the original bank calendar.</p></header>
<section class="timeline" aria-label="Upcoming rate announcements">
{next.length?next.map(e=><article class="event"><div class="when"><time datetime={e.date}>{reportDate(e.date)}</time></div><div class="event-main"><div class="eyebrow">{e.currency} · {e.bank}</div><h2>{e.title}</h2><p>{e.watch}</p><a href={e.source} target="_blank" rel="noopener noreferrer">Official {e.bank} calendar ↗</a></div></article>):<p>No future meeting dates remain in this curated schedule. Visit the official central-bank calendars below.</p>}
</section>
<section class="bank-links"><h2>Official calendars and related research</h2><div class="bankgrid">{Object.entries(officialDecisionSources).map(([currency,item])=><article><strong>{currency} · {item.short}</strong><p>{item.bank}</p><a href={item.url} target="_blank" rel="noopener noreferrer">Official calendar ↗</a><div class="pairchips">{allTrade90Pairs.filter(p=>p.base===currency||p.quote===currency).slice(0,3).map(p=><a href={pairUrl(p.symbol)}>{p.label}</a>)}</div></article>)}</div></section>
</main>
</Layout>
<style>.reviewed{font-size:.78rem!important;color:#94a3b8!important}.timeline{border:1px solid #334155;background:#111c30;border-radius:14px;overflow:hidden;margin:22px 0}.event{display:grid;grid-template-columns:185px 1fr;border-bottom:1px solid #334155;padding:17px 21px;gap:18px}.event:last-child{border:0}.when{font-weight:850;color:#d1fae5;font-size:1.05rem}.eyebrow{color:#34d399;font-size:.69rem;text-transform:uppercase;letter-spacing:.08em;font-weight:800}.event-main h2{font-size:1.03rem;margin:5px 0}.event-main p{color:#a5b4c8;font-size:.8rem;margin:0 0 10px}.event-main a{font-size:.79rem}.bank-links h2{font-size:1.35rem}.bankgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:15px 0 32px}.bankgrid article{border:1px solid #334155;background:#111c30;border-radius:10px;padding:14px}.bankgrid strong{color:#e2e8f0}.bankgrid p{font-size:.75rem;color:#94a3b8}.bankgrid a{font-size:.76rem}.pairchips{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.pairchips a{border:1px solid #334155;padding:4px 6px;border-radius:5px;text-decoration:none}@media(max-width:760px){.bankgrid{grid-template-columns:repeat(2,1fr)}.event{grid-template-columns:1fr;gap:6px}}</style>