---
import Trade90V2Layout from "../../layouts/Trade90V2Layout.astro";
import {lessons} from "../../data/v2-lessons.js";
export function getStaticPaths(){
 return lessons.map(lesson=>({params:{slug:lesson.slug},props:{lesson}}));
}
const {lesson}=Astro.props;
const article={"@context":"https://schema.org","@type":"Article","@id":"https://tradeninety.com/learn/"+lesson.slug+"/#article",headline:lesson.title,description:lesson.description,dateModified:lesson.updated,inLanguage:"en",mainEntityOfPage:"https://tradeninety.com/learn/"+lesson.slug+"/",author:{"@type":"Person","@id":"https://tradeninety.com/about/#charitha-amarasinghe",name:"Charitha Amarasinghe",url:"https://tradeninety.com/about/#charitha-amarasinghe",worksFor:{"@type":"Organization",name:"TRADE90",url:"https://tradeninety.com/"}},publisher:{"@type":"Organization",name:"TRADE90",url:"https://tradeninety.com/"},citation:lesson.sources.map(source=>source.url)};
const questions=lesson.sections.filter(section=>section.heading.endsWith("?"));
const faq={"@context":"https://schema.org","@type":"FAQPage",mainEntity:questions.map(section=>({"@type":"Question",name:section.heading,acceptedAnswer:{"@type":"Answer",text:section.paragraphs.join(" ")}}))};
const related=lessons.filter(item=>lesson.related.includes(item.slug));
const breadcrumbs={"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
 {"@type":"ListItem","position":1,"name":"Home","item":"https://tradeninety.com/"},
 {"@type":"ListItem","position":2,"name":"Learn","item":"https://tradeninety.com/learn/"},
 {"@type":"ListItem","position":3,"name":lesson.title,"item":"https://tradeninety.com/learn/"+lesson.slug+"/"}]};
---
<Trade90V2Layout title={lesson.title} description={lesson.description} canonical={"/learn/"+lesson.slug+"/"}>
<script type="application/ld+json" set:html={JSON.stringify(article)}/><script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)}/>{questions.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(faq)}/>}<main class="wrap">
 <article class="article">
  <header class="page-intro"><span class="eyebrow">Trade90 · Monetary policy explained</span><h1>{lesson.title}</h1><p>{lesson.description}</p></header>
  <p>By <a href="/about/#publisher" rel="author">Charitha Amarasinghe</a>, <a href="/about/#publisher">TRADE90</a> · Updated <time datetime={lesson.updated}>{lesson.updated}</time> · <a href="/editorial-policy/">Editorial standards and corrections</a></p>
  <p class="answer"><strong>Quick answer:</strong> {lesson.answer}</p>
  <p class="tool"><strong>Want to see current numbers?</strong> <a href="/">Open the 28-pair central bank rate comparison →</a></p>
  {lesson.sections.map(section=><section><h2>{section.heading}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}</section>)}
  <aside class="sources"><h2>Further reading and primary sources</h2><ul>{lesson.sources.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name} ↗</a></li>)}</ul><p>Links are provided for verification and education, not as endorsements of trading strategies.</p></aside>
  <nav aria-label="Apply this guide"><h2>Apply this research</h2><ul>{lesson.relatedPairs.map(slug=><li><a href={"/pairs/"+slug+"/"}>{slug.replace("-","/").toUpperCase()} policy rates and macro evidence</a></li>)}</ul><p><a href="/">Check current rate divergence across 28 pairs →</a> · <a href="/yield-curves/">Explore dated yield curves →</a></p></nav>
  <nav aria-label="Related guides"><h2>Continue reading</h2><ul>{related.map(item=><li><a href={"/learn/"+item.slug+"/"}>{item.title}</a></li>)}</ul></nav>
  <p>Published by TRADE90 as educational policy research, not personalised financial advice. Examples are hypothetical unless explicitly dated and sourced. See our <a href="/disclaimer/">risk disclaimer</a> and <a href="/editorial-policy/">source and correction standards</a>.</p>
  <p class="back"><a href="/learn/">← More Trade90 guides</a></p>
 </article>
</main>
</Trade90V2Layout>
<style>.article{padding-bottom:35px}.article h2{font-size:1.32rem}.tool{padding:14px;background:#152739;border:1px solid #334155;border-radius:12px;margin:4px 0 24px;color:#e2e8f0}.sources{background:#111c30;border:1px solid #334155;border-radius:13px;padding:20px;margin-top:30px}.sources h2{margin-top:0}.sources p{font-size:.8rem}.back{padding-top:10px}</style>
