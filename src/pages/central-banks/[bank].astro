---
import {displayRate,displayBenchmark,midpointNote} from "../../lib/trade90-rate-display.js";
import Layout from "../../layouts/Trade90V2Layout.astro";
import OfficialReleaseFeed from "../../components/Trade90OfficialReleaseFeed.svelte";
import {rateSnapshot,allTrade90Pairs,pairUrl,reportDate,formatPercent,currencyContext} from "../../lib/trade90-v3.js";
import {officialPolicyDecisionCalendar,officialDecisionSources,decisionCalendarReviewedAt} from "../../data/trade90-decision-calendar.js";
import {policyUpdates,policyCollectionAsOf} from "../../data/trade90-policy-updates.js";
export function getStaticPaths(){return rateSnapshot.banks.map(bank=>({params:{bank:bank.short.toLowerCase()},props:{bank}}));}
const {bank}=Astro.props;
const relatedPairs=allTrade90Pairs.filter(p=>p.base===bank.code||p.quote===bank.code);
const releases=policyUpdates.filter(item=>item.currency===bank.code).slice(0,6);
const schedules=officialPolicyDecisionCalendar.filter(e=>e.currency===bank.code&&e.date>=new Date().toISOString().slice(0,10)).slice(0,3);
const description=bank.name+" monetary policy: official "+displayBenchmark(bank)+" "+displayRate(bank)+" verified "+reportDate(rateSnapshot.asOf)+", next decisions and seven related FX pairs.";
const url="/central-banks/"+bank.short.toLowerCase()+"/";
---
<Layout title={bank.short+" Interest Rate & Policy Decisions"} description={description} canonical={url}>
<main class="wrap hub">
<nav class="crumbs"><a href="/">Home</a> › <a href="/central-banks/">Central banks</a> › <span>{bank.short}</span></nav>
<header class="page-intro"><span class="eyebrow">{bank.code} · OFFICIAL POLICY SOURCE</span><h1>{bank.name} — Interest Rate &amp; Policy</h1><p>Explore the selected policy benchmark, original releases, next scheduled decisions and the seven forex currency pairs involving {bank.code}.</p></header>
<section class="summary"><div class="rate"><span>Official benchmark · {displayBenchmark(bank)}</span><strong>{displayRate(bank)}</strong>{bank.code==="USD"&&<span>{midpointNote(bank)}</span>}<span>Effective {reportDate(bank.effectiveDate)}</span></div><div class="details"><h2>Latest verified policy decision</h2><p><strong>{bank.decision}</strong> · {reportDate(bank.decisionDate)}. Rate data checked {reportDate(rateSnapshot.asOf)}; this is a curated snapshot rather than a real-time quote.</p><a href={bank.source} target="_blank" rel="noopener noreferrer">Read {bank.short} official decision ↗</a></div></section>
<section class="part"><h2>Next policy decisions to watch</h2><p>Dates reviewed {reportDate(decisionCalendarReviewedAt)}. Official schedules can change, so confirm using <a href={officialDecisionSources[bank.code].url} target="_blank" rel="noopener noreferrer">{bank.short}'s published calendar ↗</a>.</p><div class="events">{schedules.length?schedules.map(e=><article><strong><time datetime={e.date}>{reportDate(e.date)}</time></strong><span>{e.title}</span><p>{e.watch}</p></article>):<article>No later announcement was verified in this collection. Refer to the official calendar.</article>}</div></section>
<section class="part"><h2>Official {bank.short} policy updates</h2><p>Last reviewed {reportDate(policyCollectionAsOf)}. These source-dated records are not a breaking-news feed.</p><div class="news">{releases.map(e=><article><span>{reportDate(e.publishedDate)} · {e.type}</span><h3>{e.title}</h3><p>{e.summary}</p><a href={e.source} target="_blank" rel="noopener noreferrer">Original {bank.short} source ↗</a></article>)}</div></section>
<OfficialReleaseFeed client:load currency={bank.code} limit={5}/>
<section class="part"><h2>Seven forex pairs involving {bank.code}</h2><p>Each pair compares this central bank with one other policy benchmark and links to their two official publications.</p><div class="pairs">{relatedPairs.map(p=><a href={pairUrl(p.symbol)}><strong>{p.label}</strong><span>{p.signedBp>0?"+":""}{p.signedBp} bp →</span></a>)}</div></section>
<section class="part"><h2>How to interpret the {bank.code} benchmark</h2><p>{currencyContext[bank.code].benchmark} is the selected benchmark for {bank.name}. Traders monitor {currencyContext[bank.code].drivers}. Its nominal rate is not by itself a price forecast for {bank.code} or a brokerage swap quote.</p><p>For the underlying definitions and policy-gap calculations, see <a href="/methodology/">TRADE90 methodology</a>.</p></section>
</main></Layout>
<style>.hub{padding-bottom:30px}.crumbs{font-size:.75rem;padding-top:18px;color:#94a3b8}.crumbs a{color:#93c5fd}.summary{display:grid;grid-template-columns:1fr 2fr;gap:12px}.rate,.details,.part{border:1px solid #334155;background:#111c30;border-radius:13px;padding:21px}.rate{display:flex;flex-direction:column;gap:9px}.rate strong{font-size:2.15rem;color:#d1fae5}.rate span{font-size:.75rem;color:#cbd5e1}.details h2,.part h2{color:#f8fafc;font-size:1.24rem;margin:0 0 10px}.details p,.part p{color:#b6c5d5;font-size:.85rem;line-height:1.7}.part{margin-top:19px}.events,.news{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.events article,.news article{background:#17263a;padding:15px;border-radius:10px;border:1px solid #334155}.events article{display:flex;flex-direction:column;gap:6px;color:#cbd5e1;font-size:.84rem}.events strong{color:#bfdbfe}.events p{font-size:.76rem;margin:0}.news span{color:#94a3b8;font-size:.75rem}.news h3{font-size:.95rem;margin:7px 0}.news p{font-size:.78rem}.news a{font-size:.76rem}.pairs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.pairs a{display:flex;flex-direction:column;gap:4px;border:1px solid #334155;background:#17263a;color:#e2e8f0;padding:12px;border-radius:9px;text-decoration:none}.pairs a:hover{border-color:#3b82f6}.pairs span{font-size:.75rem;color:#bfdbfe}@media(max-width:710px){.summary{grid-template-columns:1fr}.events,.news{grid-template-columns:1fr}.pairs{grid-template-columns:repeat(2,1fr)}}</style>