---
import {displayRate,displayBenchmark,midpointNote} from "../../lib/trade90-rate-display.js";
import Trade90V2Layout from "../../layouts/Trade90V2Layout.astro";
import Trade90PolicyUpdates from "../../components/Trade90PolicyUpdates.svelte";
import OfficialReleaseFeed from "../../components/Trade90OfficialReleaseFeed.svelte";
import {rateSnapshot,formatPercent,reportDate} from "../../lib/trade90-v3.js";
import {officialPolicyDecisionCalendar} from "../../data/trade90-decision-calendar.js";
const today=new Date().toISOString().slice(0,10);
const nextFor=code=>officialPolicyDecisionCalendar.filter(e=>e.currency===code&&e.date>=today).sort((a,b)=>a.date.localeCompare(b.date))[0];
---
<Trade90V2Layout
 title="Central Bank Updates: Rates & Decisions"
 description="Official monetary-policy decisions, meeting minutes and policy communications from the Fed, ECB, Bank of England, Bank of Japan, RBA, RBNZ, Bank of Canada and SNB, with dated primary-source links."
 canonical="/central-banks/">
  <main class="wrap">
    <header class="page-intro">
      <div class="eyebrow">Eight central banks · Official primary sources</div>
      <h1>Central Bank Policy Updates</h1>
      <p>Follow actual monetary-policy decisions, minutes, statements and reports for the currencies traded on TRADE90. Read what banks really published, separate from what derivatives markets currently expect.</p>
    </header>
    <section class="bankdirectory" aria-label="Explore individual central banks"><h2>Explore all eight central banks</h2><div class="banktiles">{rateSnapshot.banks.map(bank=><a href={"/central-banks/"+bank.short.toLowerCase()+"/"}><strong>{bank.code} · {bank.short}</strong><span>{bank.name}</span><small>{displayRate(bank)} · View policy and related pairs →</small></a>)}</div></section>
    <section class="ratetable" aria-labelledby="rates-heading"><h2 id="rates-heading">Current central bank interest rates</h2><p>Published policy benchmarks for the eight central banks tracked by TRADE90. Benchmark data last changed <time datetime={rateSnapshot.asOf}>{reportDate(rateSnapshot.asOf)}</time>; each rate links to its bank page and official source.</p>
     <div class="tablewrap"><table><thead><tr><th scope="col">Central bank</th><th scope="col">Currency</th><th scope="col">Policy rate</th><th scope="col">Benchmark</th><th scope="col">Effective</th><th scope="col">Last decision</th><th scope="col">Next decision</th></tr></thead>
     <tbody>{rateSnapshot.banks.map(bank=>{const next=nextFor(bank.code);return <tr><th scope="row"><a href={"/central-banks/"+bank.short.toLowerCase()+"/"}>{bank.name} ({bank.short})</a></th><td>{bank.code}</td><td><strong>{displayRate(bank)}</strong></td><td>{displayBenchmark(bank)}</td><td><time datetime={bank.effectiveDate}>{reportDate(bank.effectiveDate)}</time></td><td>{bank.decision} · {reportDate(bank.decisionDate)}</td><td>{next?<time datetime={next.date}>{reportDate(next.date)}</time>:"See official calendar"}</td></tr>})}</tbody></table></div>
     <p class="tablenote">The Fed publishes a target range; TRADE90 rate-gap calculations use its midpoint. These are policy benchmarks, not broker swap rates or forecasts. <a href="/decisions/">Full decision calendar →</a></p></section>
    <Trade90PolicyUpdates client:visible />
    <OfficialReleaseFeed client:visible limit={8} />
    <aside class="explainer">
      <h2>What counts as a policy update?</h2>
      <p><strong>Rate decisions</strong> announce an official benchmark and its effective date. <strong>Minutes</strong> describe the discussion at an earlier meeting. <strong>Statements</strong> and <strong>policy reports</strong> explain policymakers' assessments and projections. None of these automatically tells us what a market-implied 3-, 6- or 12-month rate will be.</p>
      <p>TRADE90 maintains both an older editorially curated collection and a separate hourly automated official-link archive shown above. Automatic link detection is not verification of an interest-rate decision or a guarantee of immediate discovery. For the latest release, always open the bank's original link. The <a href="/">Current Rate Gaps</a> calculation remains based on a separately verified policy-rate snapshot.</p>
      <a href="/methodology/">Read the rate-gap and source methodology →</a>
    </aside>
  </main>
</Trade90V2Layout>
<style>
.ratetable{margin:0 0 33px}.ratetable h2{font-size:1.3rem}.ratetable p{color:#b6c5d5;font-size:.85rem;line-height:1.7}.tablewrap{overflow-x:auto;border:1px solid #334155;border-radius:11px}.ratetable table{width:100%;border-collapse:collapse;font-size:.8rem;min-width:720px}.ratetable th,.ratetable td{text-align:left;padding:10px 12px;border-bottom:1px solid #334155;color:#cbd5e1}.ratetable thead th{background:#111c30;color:#f8fafc;font-size:.72rem;letter-spacing:.03em}.ratetable tbody tr:last-child th,.ratetable tbody tr:last-child td{border-bottom:0}.ratetable td strong{color:#d1fae5}.ratetable .tablenote{font-size:.76rem}
.bankdirectory{margin:16px 0 33px}.bankdirectory h2{font-size:1.3rem}.banktiles{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.banktiles a{display:flex;flex-direction:column;gap:5px;text-decoration:none;background:#111c30;border:1px solid #334155;border-radius:11px;padding:14px;color:#f8fafc}.banktiles a:hover{border-color:#3b82f6}.banktiles span{color:#94a3b8;font-size:.76rem}.banktiles small{font-size:.7rem;color:#93c5fd;margin-top:5px}@media(max-width:780px){.banktiles{grid-template-columns:repeat(2,1fr)}}

.explainer{border:1px solid #334155;border-radius:14px;padding:22px;background:#111d2f;margin:30px 0;color:#cbd5e1}
.explainer h2{font-size:1.2rem;color:#f8fafc;margin:0 0 10px}
.explainer p{font-size:.85rem;line-height:1.75}
.explainer a{font-size:.84rem;color:#93c5fd}
</style>
