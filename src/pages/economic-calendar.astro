---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Economic Calendar — Global Forex & Macro Events';
const description = 'Track upcoming global economic releases and central-bank events, then open the related TRADE90 market research for FX, Gold and Bitcoin.';
const markets = [
  ['EUR/USD','eurusd'],['GBP/USD','gbpusd'],['USD/JPY','usdjpy'],
  ['USD/CHF','usdchf'],['USD/CAD','usdcad'],['AUD/USD','audusd'],
  ['NZD/USD','nzdusd'],['XAU/USD','xauusd'],['BTC/USD','btcusd']
];
const schema = {
  "@context":"https://schema.org",
  "@type":"WebPage",
  name:title,
  description,
  url:"https://tradeninety.com/economic-calendar/",
  isAccessibleForFree:true,
  about:[
    {"@type":"Thing","name":"Economic calendar"},
    {"@type":"Thing","name":"Macroeconomic releases"},
    {"@type":"Thing","name":"Foreign exchange market research"}
  ],
  publisher:{"@type":"Organization","name":"TRADE90","url":"https://tradeninety.com/"}
};
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head-extra">
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </Fragment>

  <main class="calendar-page">
    <header>
      <p class="eyebrow">Daily research utility</p>
      <h1>Economic calendar</h1>
      <p>Track scheduled economic releases and central-bank events, then inspect the related TRADE90 research before and after the event. Calendar data below is provided by TradingView and remains separate from TRADE90's own research feed.</p>
      <div class="actions">
        <a class="primary" href="/#terminal">Open research terminal</a>
        <a href="/today/">Open Today dashboard</a>
      </div>
    </header>

    <section class="calendar-shell" aria-label="Global economic calendar">
      <div class="calendar-note">
        <strong>Use the calendar as a timing tool, not a signal.</strong>
        <span>Compare actual, forecast and previous values where available, then check how yields, policy expectations and price respond.</span>
      </div>
      <div class="tradingview-widget-container">
        <div class="tradingview-widget-container__widget"></div>
        <div class="tradingview-widget-copyright">
          <a href="https://www.tradingview.com/economic-calendar/" rel="noopener nofollow" target="_blank">Economic Calendar by TradingView</a>
        </div>
        <script
          type="text/javascript"
          src="https://s3.tradingview.com/external-embedding/embed-widget-events.js"
          async
          set:html={JSON.stringify({
            colorTheme: "light",
            isTransparent: true,
            locale: "en",
            countryFilter: "au,ca,cn,fr,de,jp,nz,ch,gb,us,eu",
            importanceFilter: "-1,0,1",
            width: "100%",
            height: 720
          })}
        ></script>
      </div>
    </section>

    <section class="research-links">
      <p class="eyebrow">After the release</p>
      <h2>Open the affected market research</h2>
      <p>TRADE90 keeps the event itself separate from market interpretation. Re-check the research brief, evidence balance, positioning and price response after a major release.</p>
      <div>
        {markets.map(([symbol,slug]) => <a href={`/research/${slug}/`}>{symbol}<span>Research →</span></a>)}
      </div>
    </section>

    <section class="method">
      <h2>How to use an economic calendar without over-reading it</h2>
      <div>
        <article><strong>1 · Before</strong><p>Record the scheduled time, consensus and previous value. Know which currencies are directly involved.</p></article>
        <article><strong>2 · At release</strong><p>Separate the actual number from the first price move. Revisions and component details can matter.</p></article>
        <article><strong>3 · After</strong><p>Check yields, policy expectations, price structure and conflicting evidence before changing a research view.</p></article>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.calendar-page{background:#f8fafc;color:#172b3a;padding:36px 20px 56px}.calendar-page>*{max-width:1180px;margin-left:auto;margin-right:auto}.eyebrow{margin:0 0 8px;color:#047857;font-size:.7rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}header h1{margin:0;color:#0f172a;font-size:clamp(2.4rem,6vw,4.7rem);line-height:.96;letter-spacing:-.055em;font-weight:950}header>p:not(.eyebrow){max-width:820px;color:#526474;line-height:1.65}.actions{display:flex;flex-wrap:wrap;gap:9px;margin:18px 0 28px}.actions a{display:inline-flex;align-items:center;min-height:44px;padding:0 13px;border:1px solid #cbd5e1;border-radius:9px;background:#fff;color:#065f46;font-size:.78rem;font-weight:900;text-decoration:none}.actions .primary{background:#064e3b;border-color:#064e3b;color:#fff}.calendar-shell{border:1px solid #dbe3ec;border-radius:18px;background:#fff;overflow:hidden}.calendar-note{display:flex;justify-content:space-between;gap:18px;padding:14px 18px;background:#ecfdf5;border-bottom:1px solid #a7f3d0}.calendar-note strong{color:#065f46;font-size:.78rem}.calendar-note span{color:#526474;font-size:.72rem;text-align:right}.tradingview-widget-container{padding:4px;min-height:720px}.tradingview-widget-copyright{padding:6px 12px 12px;font-size:.68rem;color:#64748b}.tradingview-widget-copyright a{color:#065f46}.research-links,.method{padding-top:38px}.research-links h2,.method h2{margin:0;color:#0f172a;font-size:1.55rem;letter-spacing:-.035em}.research-links>p:not(.eyebrow){max-width:760px;color:#526474}.research-links>div{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:15px}.research-links a{display:flex;justify-content:space-between;gap:10px;padding:14px;border:1px solid #dbe3ec;border-radius:11px;background:#fff;color:#172b3a;font-weight:900;text-decoration:none}.research-links a span{color:#047857;font-size:.72rem}.method>div{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}.method article{padding:17px;border:1px solid #dbe3ec;border-radius:13px;background:#fff}.method article strong{color:#065f46}.method article p{color:#526474;font-size:.8rem;line-height:1.55}@media(max-width:720px){.calendar-page{padding:26px 10px 42px}.calendar-note{flex-direction:column}.calendar-note span{text-align:left}.research-links>div,.method>div{grid-template-columns:1fr}.tradingview-widget-container{min-height:650px}}
</style>
