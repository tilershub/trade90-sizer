---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact TRADE90"
  description="Contact TRADE90 about the market research terminal, risk tools, methodology, data sources, corrections, or professional inquiries."
>
  <main class="max-w-3xl mx-auto py-20 px-6">
    <p class="text-emerald-500 text-[10px] font-black uppercase tracking-[0.3em] mb-3">TRADE90</p>
    <h1 class="text-4xl font-black text-white mb-4">Contact</h1>
    <p class="text-slate-400 mb-10 max-w-2xl">Questions about the research terminal, methodology, data sources, risk tools, corrections or professional inquiries are welcome.</p>
    <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl">
      <p class="text-slate-500 uppercase text-[10px] tracking-widest mb-2">Email</p>
      <a href="mailto:admin@tradeninety.com" class="text-xl md:text-2xl font-mono text-emerald-500 hover:text-white transition-colors break-all">
        admin@tradeninety.com
      </a>
      <p class="text-slate-500 text-sm mt-5">For a data or editorial correction, include the page URL, the item you believe is incorrect, and the source you are comparing it with.</p>
    </div>
  </main>
</BaseLayout>
