---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberAuth from '../components/MemberAuth.svelte';
---
<BaseLayout
  title="Create account — TRADE90 Member Workspace"
  description="Create a TRADE90 account to sync your watchlist, research history, journal and research plan across devices."
  noIndex={true}
>
  <section class="min-h-[68vh] px-5 py-16 flex items-center">
    <div class="w-full">
      <MemberAuth mode="join" client:load />
    </div>
  </section>
</BaseLayout>
